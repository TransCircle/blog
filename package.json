{
  "name": "transcircle-blog",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "node scripts/generate-og-fonts.mjs --if-needed && astro dev",
    "start": "pnpm dev",
    "build": "node scripts/generate-og-fonts.mjs --if-needed && astro build && node scripts/generate-pdfs.mjs && node scripts/check-seo.mjs --require-pdfs && node scripts/indexnow.mjs --ci && node scripts/baidu-push.mjs --ci",
    "build:site": "node scripts/generate-og-fonts.mjs --if-needed && astro build",
    "pdf": "node scripts/generate-pdfs.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:seo": "node scripts/check-seo.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "og:fonts": "node scripts/generate-og-fonts.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "baidu-push": "node scripts/baidu-push.mjs"
  },
  "dependencies": {
    "astro": "^5.7.10",
    "fuse.js": "^7.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "6.3.11",
    "@astrojs/sitemap": "^3.3.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4",
    "@types/node": "^22.15.18",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "eslint-plugin-astro": "^1.3.1",
    "github-slugger": "2.0.0",
    "globals": "^17.6.0",
    "hast-util-from-html": "2.0.3",
    "hast-util-to-html": "9.0.5",
    "mdast-util-to-string": "4.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "puppeteer": "^25.3.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "satori": "^0.26.0",
    "subset-font": "^2.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.4",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@10.32.1"
}
