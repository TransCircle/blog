---
import LinkConfirmDialog from '@components/LinkConfirmDialog.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  author?: string;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  category?: string;
  wordCount?: number;
  isHome?: boolean;
}

const {
  title,
  description = 'TransCircle 开发博客 - 记录项目进度与团队报告',
  image,
  type = 'website',
  author,
  pubDate,
  updatedDate,
  tags = [],
  category,
  wordCount,
  isHome = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteURL = Astro.site ? Astro.site.toString() : 'https://blog.transcircle.org';

// 动态关键词：标签 + 固定品牌词
const baseKeywords = 'TransCircle, 跨环, 跨性别, 开发博客, MtF, 跨性别女性, 开源, 技术博客';
const dynamicKeywords = tags.length > 0 ? `${tags.join(', ')}, ${baseKeywords}` : baseKeywords;

// OG 图片默认值
const ogImage = image || '/og-cover.png';
const ogImageURL = new URL(ogImage, Astro.site).toString();

// JSON-LD 数据
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteURL}#organization`,
  name: 'TransCircle Project',
  alternateName: ['跨环', '跨性别圈工程', '跨性别中文圈', '中文跨性别圈', 'TransCircleProject'],
  url: 'https://transcircle.org/',
  logo: {
    '@type': 'ImageObject',
    url: `${siteURL}icon-512.png`,
    width: 512,
    height: 512,
  },
  image: `${siteURL}og-cover.png`,
  description: '跨环（TransCircle Project）是一个面向中文 MtF 跨性别社群的史官档案工程，致力于归档社群故事、记录抗争历史、团结同伴、争取跨性别权利。',
  sameAs: [
    'https://github.com/TransCircle/TransCircle',
    'https://x.com/TransCircleOrg',
    'https://bsky.app/profile/TransCircle.org',
  ],
  knowsAbout: [
    '跨环', '跨性别', 'MtF', 'Male-to-Female', '性别认同', '跨性别历史',
    '跨性别社群档案', '中文 MtF 社群', '跨性别故事', 'TransCircle',
    'TransCircle Project', 'transgender community', 'Chinese MtF community',
  ],
  inLanguage: 'zh-CN',
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteURL}#website`,
  url: siteURL,
  name: 'TransCircle Development Blog',
  alternateName: '跨环开发博客',
  description: '跨环（TransCircle Project）官方开发博客：公开记录项目进度、团队报告与技术分享，服务于中文 MtF 跨性别社群。',
  inLanguage: 'zh-CN',
  publisher: { '@id': `${siteURL}#organization` },
  copyrightHolder: { '@id': `${siteURL}#organization` },
  copyrightYear: 2026,
  license: 'https://creativecommons.org/licenses/by-sa/4.0/',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${siteURL}#faq`,
  inLanguage: 'zh-CN',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'TransCircle Development Blog 是什么？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '跨环开发博客（TransCircle Development Blog）是跨环（TransCircle Project）的官方开发文档站点，用于透明地记录项目开发历程、团队运作与技术探索，服务于中文 MtF 跨性别社群。',
      },
    },
    {
      '@type': 'Question',
      name: '这个博客与 TransCircle Project 主站是什么关系？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '本博客是跨环主站（https://transcircle.org）的配套开发文档站点。主站聚焦项目介绍与社群入口，博客聚焦技术实现、架构决策与团队协作的公开记录。',
      },
    },
    {
      '@type': 'Question',
      name: '如何引用博客上的内容？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '文字内容遵循 CC BY-SA 4.0 协议，代码片段遵循 AGPL-3.0 协议。引用时请保留原始 URL（https://blog.transcircle.org/）并注明来源"TransCircle Development Blog"。',
      },
    },
    {
      '@type': 'Question',
      name: '如何参与 TransCircle Project 的开发？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '可以通过 GitHub 仓库（github.com/TransCircle/TransCircle）提交 PR 或 Issue，也可以通过主站的申请表单（https://transcircle.org/s/join）加入项目协作。',
      },
    },
  ],
};

const articleSchema = type === 'article' && pubDate ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  url: canonicalURL.toString(),
  datePublished: pubDate.toISOString(),
  dateModified: updatedDate?.toISOString() || pubDate.toISOString(),
  author: {
    '@type': 'Person',
    name: author || 'TransCircle Team',
  },
  publisher: {
    '@type': 'Organization',
    name: 'TransCircle Project',
    url: 'https://transcircle.org',
    logo: {
      '@type': 'ImageObject',
      url: `${siteURL}icon-512.png`,
    },
  },
  keywords: tags?.join(', ') || '',
  articleSection: category || 'general',
  license: 'https://creativecommons.org/licenses/by-sa/4.0/',
  inLanguage: 'zh-CN',
  ...(wordCount ? { wordCount } : {}),
  ...(image ? { image: ogImageURL } : {}),
} : null;

const jsonLdSchemas = [];
if (isHome) {
  jsonLdSchemas.push(orgSchema, websiteSchema, faqSchema);
}
if (articleSchema) {
  if (!isHome) jsonLdSchemas.push(orgSchema);
  jsonLdSchemas.push(articleSchema);
}

const jsonLdScript = jsonLdSchemas.length > 0
  ? JSON.stringify(jsonLdSchemas.length === 1 ? jsonLdSchemas[0] : { '@graph': jsonLdSchemas })
  : null;
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <title>{title} | TransCircle Blog</title>
    <meta name="description" content={description} />
    <meta name="author" content={author || 'TransCircle Team'} />
    <meta name="keywords" content={dynamicKeywords} />
    <meta name="application-name" content="TransCircle Development Blog" />
    <meta name="generator" content="Astro" />
    <meta name="rating" content="general" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Robots -->
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <meta name="bingbot" content="index, follow" />

    <!-- Theme -->
    <meta name="theme-color" content="#ff85a2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12121a" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta name="msapplication-TileColor" content="#ff85a2" />

    <!-- Canonical & Alternate -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="zh-CN" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="TransCircle Development Blog" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — TransCircle Development Blog`} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@TransCircleOrg" />
    <meta name="twitter:creator" content="@TransCircleOrg" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={`${title} — TransCircle Development Blog`} />

    <!-- Article meta -->
    {type === 'article' && pubDate && (
      <>
        <meta property="article:published_time" content={pubDate.toISOString()} />
        {author && <meta property="article:author" content={author} />}
        {category && <meta property="article:section" content={category} />}
        {tags.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}
    {type === 'article' && updatedDate && (
      <meta property="article:modified_time" content={updatedDate.toISOString()} />
    )}

    <!-- Icons -->
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="icon" type="image/png" href="/icon-512.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- JSON-LD -->
    {jsonLdScript && (
      <script is:inline type="application/ld+json" set:html={jsonLdScript} />
    )}

    <!-- Theme script -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('transcircle-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>

    <style is:global>
      @import '../styles/global.css';
      @import '../styles/animations.css';
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link">跳转到主内容</a>
    <slot />

    <!-- 外链跳转确认弹窗（全站共用，拦截带 data-confirm-link 的链接） -->
    <LinkConfirmDialog />

    <!-- Noscript fallback -->
    <noscript>
      <style>
        .noscript-notice {
          position: fixed;
          bottom: 0;
          left: 0;
          right: 0;
          padding: 0.75rem;
          background: var(--bg-secondary);
          border-top: 1px solid var(--divider-color);
          text-align: center;
          font-size: 0.85rem;
          color: var(--text-secondary);
          z-index: 100;
        }
      </style>
      <div class="noscript-notice">
        您已禁用 JavaScript。本站核心内容可正常访问，但主题切换和搜索功能需要启用 JavaScript。
      </div>
    </noscript>

    <script>
      // Scroll-triggered animations
      const observerCallback = (entries: IntersectionObserverEntry[], observer: IntersectionObserver) => {
        entries.forEach((entry: IntersectionObserverEntry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      };

      const observer = new IntersectionObserver(observerCallback, {
        root: null,
        rootMargin: '0px 0px -50px 0px',
        threshold: 0.1,
      });

      const observeElements = () => {
        document.querySelectorAll('.scroll-animate').forEach((el) => {
          observer.observe(el);
        });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', observeElements);
      } else {
        observeElements();
      }
    </script>
  </body>
</html>
