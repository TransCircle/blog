---
import LinkConfirmDialog from '@components/LinkConfirmDialog.astro';
import {
  buildGraph,
  breadcrumbNode,
  organizationNode,
  primaryImageNode,
  serializeJsonLd,
  webPageNode,
  websiteNode,
  type JsonLdNode,
  type WebPageType,
} from '@/lib/seo/schema';
import {
  CONTENT_LICENSE_URL,
  DEFAULT_OG_IMAGE_PATH,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_VERSION,
  OG_IMAGE_WIDTH,
  OG_LOCALE,
  ORG_URL,
  SITE_DESCRIPTION,
  SITE_LANGUAGE,
  SITE_NAME,
  SITE_TITLE,
  SOCIAL_PROFILES,
  THEME_COLOR_DARK,
  THEME_COLOR_LIGHT,
  TILE_COLOR,
  TWITTER_HANDLE,
} from '@/lib/seo/site';
import { absoluteUrl, normalizePagePath } from '@/lib/seo/url';

interface Breadcrumb {
  name: string;
  item: string;
}

/** 同一内容的其他格式 / 订阅源：<link rel="alternate">。 */
interface Alternate {
  type: string;
  href: string;
  title: string;
}

export interface Props {
  title: string;
  description?: string;
  /** 分享图的站内路径（默认站点卡片）；会自动带上版本号并转为绝对 URL。 */
  image?: string;
  imageAlt?: string;
  /** Open Graph 类型。 */
  type?: 'website' | 'article';
  /** schema.org WebPage 子类型。 */
  pageType?: WebPageType;
  /** meta author 的纯文本署名。 */
  author?: string;
  /** article:author 的 URL（站内作者页）；缺省指向主站。 */
  authorUrls?: string[];
  /** twitter:creator：内容作者的 X 账号（@handle）。不传就不输出——站点账号只放在 twitter:site。 */
  twitterCreator?: string;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  category?: string;
  /** 首页：<title> 不追加站名后缀（标题本身已含站名）。 */
  isHome?: boolean;
  noindex?: boolean;
  breadcrumbs?: Breadcrumb[];
  /** 页面自有的 JSON-LD 节点（不带 @context），与全站节点合并成一个 @graph。 */
  additionalSchemas?: JsonLdNode[];
  /** 页面主体节点的 @id（文章 / FAQ / 列表），写进 WebPage.mainEntity。 */
  mainEntityId?: string;
  /** 审阅者实体的 @id（WebPage.reviewedBy）。 */
  reviewedBy?: string[];
  lastReviewed?: Date;
  alternates?: Alternate[];
  /**
   * 本页内容的许可证 URL。不传时为站点默认（CC BY-SA 4.0）；传 null 表示没有公开许可证
   * （例如 frontmatter 声明 Proprietary 的文章），此时不输出 rel="license"。
   */
  license?: string | null;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image,
  imageAlt,
  type = 'website',
  pageType = 'WebPage',
  author,
  authorUrls = [],
  twitterCreator,
  pubDate,
  updatedDate,
  tags = [],
  category,
  isHome = false,
  noindex = false,
  breadcrumbs = [],
  additionalSchemas = [],
  mainEntityId,
  reviewedBy,
  lastReviewed,
  alternates = [],
  license = CONTENT_LICENSE_URL,
} = Astro.props;

// canonical 一律由 URL 模块规整（带尾斜杠、段编码一致），与内链、sitemap 逐字相同
const canonicalPath = normalizePagePath(Astro.url.pathname);
const canonicalURL = absoluteUrl(canonicalPath);

const fullTitle = isHome ? title : `${title} | ${SITE_NAME}`;

// 关键词：Google 已忽略 keywords，但百度 / 360 / 搜狗仍会参考；只放标签、分类与少量品牌词
const baseKeywords = ['跨环', 'TransCircle', '跨环博客', '跨性别', 'MtF'];
const keywords = [...new Set([...tags, ...(category ? [category] : []), ...baseKeywords])].join(', ');

// 分享图：带版本号（换图后社交平台才会重抓），转绝对 URL
const ogImagePath = image || DEFAULT_OG_IMAGE_PATH;
const ogImageURL = `${absoluteUrl(ogImagePath)}?v=${OG_IMAGE_VERSION}`;
const ogImageAlt = imageAlt || `${title} — ${SITE_TITLE}`;

// 列表页只传 updatedDate（最新文章的修改时间）；文章页两者都传，取较晚者
const modified = updatedDate && (!pubDate || updatedDate > pubDate) ? updatedDate : pubDate;

// 站点所有权验证：值放在 Cloudflare Pages 的环境变量里（见 docs/SEO.md），未配置就不输出
const verification = [
  { name: 'google-site-verification', content: import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION },
  { name: 'msvalidate.01', content: import.meta.env.PUBLIC_BING_SITE_VERIFICATION },
  { name: 'baidu-site-verification', content: import.meta.env.PUBLIC_BAIDU_SITE_VERIFICATION },
  { name: 'yandex-verification', content: import.meta.env.PUBLIC_YANDEX_SITE_VERIFICATION },
  { name: 'sogou_site_verification', content: import.meta.env.PUBLIC_SOGOU_SITE_VERIFICATION },
  { name: '360-site-verification', content: import.meta.env.PUBLIC_360_SITE_VERIFICATION },
].filter(
  (item): item is { name: string; content: string } =>
    typeof item.content === 'string' && item.content.length > 0
);

// JSON-LD：全站节点（组织 / 网站）+ 本页 WebPage + 面包屑 + 页面自有节点，合并成一个 @graph。
// noindex 页面（404 / 搜索）只输出组织与网站，不声明 WebPage——它们不代表任何可收录的内容。
const crumbs = breadcrumbs.map((b) => ({ name: b.name, url: b.item }));
const graphNodes: JsonLdNode[] = [organizationNode(), websiteNode()];
if (!noindex) {
  graphNodes.push(
    webPageNode({
      url: canonicalURL,
      title,
      description,
      type: pageType,
      imageUrl: ogImageURL,
      breadcrumbs: crumbs,
      datePublished: pubDate,
      dateModified: modified,
      mainEntityId,
      reviewedBy,
      lastReviewed,
    }),
    primaryImageNode(canonicalURL, ogImageURL, ogImageAlt)
  );
  if (crumbs.length > 0) graphNodes.push(breadcrumbNode(canonicalURL, crumbs));
  graphNodes.push(...additionalSchemas);
}
const jsonLdScript = serializeJsonLd(buildGraph(graphNodes));

const robotsContent = noindex
  ? 'noindex, follow'
  : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';

const feedAlternates: Alternate[] = [
  { type: 'application/rss+xml', href: '/rss.xml', title: `${SITE_NAME} RSS` },
  { type: 'application/atom+xml', href: '/atom.xml', title: `${SITE_NAME} Atom` },
  { type: 'application/feed+json', href: '/feed.json', title: `${SITE_NAME} JSON Feed` },
];
---

<!doctype html>
<!-- 不写死 data-theme：留空才能让 theme.css 里 :root:not([data-theme]) 的
     系统偏好深色回退在无 JS 时生效；有 JS 时下面的引导脚本会在首屏 paint 前写入。 -->
<html lang={SITE_LANGUAGE}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author || 'TransCircle 项目组'} />
    <meta name="keywords" content={keywords} />
    <meta name="application-name" content={SITE_NAME} />
    <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="robots" content={robotsContent} />
    {verification.map((item) => <meta name={item.name} content={item.content} />)}

    <!-- 中文搜索引擎：声明同时适配 PC 与移动端，禁止百度转码（会注入广告、改写版式） -->
    <meta name="applicable-device" content="pc,mobile" />
    <meta http-equiv="Cache-Control" content="no-transform" />
    <meta http-equiv="Cache-Control" content="no-siteapp" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Theme：theme-color 取页面底色（--bg），不是品牌强调色。取值来自 src/lib/seo/site.ts，
         必须与 src/styles/theme.css 的 --bg 逐字一致（浏览器不解析 CSS 变量）。 -->
    <meta name="theme-color" content={THEME_COLOR_LIGHT} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={THEME_COLOR_DARK} media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta name="msapplication-TileColor" content={TILE_COLOR} />
    <meta name="msapplication-config" content="/browserconfig.xml" />

    <!-- 自托管字体（DESIGN §2.6 / §9）：latin 子集 woff2，@font-face 见 global.css。
         两款字体在首屏就会用到（顶栏字标 / eyebrow / 元信息），故都预载；
         中文不做 webfont，零第三方字体请求。 -->
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/nunito-brand-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Canonical：noindex 页面不声明（404 没有自己的 URL，搜索页不代表任何内容） -->
    {!noindex && <link rel="canonical" href={canonicalURL} />}

    <!-- 实体与归属：许可证、团队、官方社交主页（rel=me 用于 Bluesky / Mastodon 等身份互认） -->
    {license && <link rel="license" href={license} />}
    <link rel="author" href="/humans.txt" type="text/plain" />
    <link rel="publisher" href={ORG_URL} />
    {SOCIAL_PROFILES.map((profile) => <link rel="me" href={profile} />)}

    <!-- 订阅源、AI 上下文与本页的其他格式 -->
    {feedAlternates.map((alt) => <link rel="alternate" type={alt.type} title={alt.title} href={alt.href} />)}
    {/* llms.txt 是整站的 Markdown 概览，只作为首页的替代表示；文章页的 text/markdown 替代版本只能是本文原文 */}
    {isHome && <link rel="alternate" type="text/markdown" title="llms.txt" href="/llms.txt" />}
    {alternates.map((alt) => <link rel="alternate" type={alt.type} title={alt.title} href={alt.href} />)}
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
    <link rel="search" href="/search/" title={`搜索${SITE_NAME}`} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content={OG_LOCALE} />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {modified && <meta property="og:updated_time" content={modified.toISOString()} />}

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={TWITTER_HANDLE} />
    {twitterCreator && <meta name="twitter:creator" content={twitterCreator} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Article meta（Open Graph article 命名空间） -->
    {type === 'article' && pubDate && (
      <>
        <meta property="article:published_time" content={pubDate.toISOString()} />
        {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
        {(authorUrls.length > 0 ? authorUrls : [ORG_URL]).map((url) => (
          <meta property="article:author" content={url} />
        ))}
        <meta property="article:publisher" content={ORG_URL} />
        {category && <meta property="article:section" content={category} />}
        {tags.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <!-- Icons：由 scripts/generate-icons.mjs 从 src/assets/brand/transcircle-mark.svg 生成 -->
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/logo-mark.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-48x48.png" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="icon" type="image/png" href="/icon-512.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <!-- JSON-LD（schema.org @graph，构建器见 src/lib/seo/schema.ts） -->
    <script is:inline type="application/ld+json" set:html={jsonLdScript} />

    <!-- 主题引导：首屏 paint 前写入 data-theme，避免明色基线先渲染再跳暗的闪白。
         主题枚举严格等于 light / dark：旧版本可能在 localStorage 里存过已废弃的
         'contrast'，这里的白名单会把它清掉。 -->
    <script is:inline>
      (function () {
        const root = document.documentElement;
        // 标记「JS 可用」：顶栏据此才把导航折叠成汉堡抽屉。无 JS 时导航链接保持可见。
        root.classList.add('js');

        const VALID = ['light', 'dark'];
        let stored = null;
        // 隐私模式 / 沙箱 iframe 下访问 localStorage 会抛 SecurityError，
        // 裸调用会让整段引导中断、主题停在浅色基线。
        try {
          stored = localStorage.getItem('transcircle-theme');
          if (stored && !VALID.includes(stored)) {
            localStorage.removeItem('transcircle-theme');
            stored = null;
          }
        } catch {
          stored = null;
        }
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        root.setAttribute('data-theme', stored || (prefersDark ? 'dark' : 'light'));
      })();
    </script>

    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link">跳转到主内容</a>
    <slot />

    <!-- 外链跳转确认弹窗（全站共用，拦截带 data-confirm-link 的链接） -->
    <LinkConfirmDialog />

    <!-- Noscript fallback -->
    <noscript>
      <style>
        .noscript-notice {
          position: fixed;
          bottom: 0;
          left: 0;
          right: 0;
          padding: 0.75rem;
          background: var(--surface);
          border-top: 1px solid var(--line);
          text-align: center;
          font-size: var(--fs-sm);
          color: var(--text-secondary);
          z-index: var(--z-toast);
        }
      </style>
      <div class="noscript-notice">
        您已禁用 JavaScript。本站核心内容可正常访问，但主题切换和搜索功能需要启用 JavaScript。
      </div>
    </noscript>

    <script>
      // 滚动 reveal（DESIGN v3.0 §6.4）：首屏以下的区块 opacity + translateY(16px) 入场，
      // IntersectionObserver 触发、每个元素只触发一次，同组内按 60ms 交错。
      //
      // 初始隐藏态写在 CSS 里，且只在 html.js + prefers-reduced-motion: no-preference 下生效
      // （见 global.css）：没有 JS 或用户要求减少动效时，内容恒可见，绝不会「永远不出现」。
      const revealItems = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));

      if (revealItems.length > 0) {
        // 交错序号按「同一父元素」计数：卡片网格里逐张错开，跨区块不互相累加延迟
        const seen = new Map<Element, number>();
        // 交错上限 8 档（8 × 60ms ≈ 0.5s）：标签墙有十几枚 chip，不封顶的话
        // 最后一枚要等近一秒才出现，会被读成「卡住了」。
        const MAX_STAGGER = 8;
        for (const el of revealItems) {
          const parent = el.parentElement ?? document.body;
          const index = seen.get(parent) ?? 0;
          el.style.setProperty('--i', String(Math.min(index, MAX_STAGGER)));
          seen.set(parent, index + 1);
        }

        if (!('IntersectionObserver' in window)) {
          revealItems.forEach((el) => el.classList.add('is-revealed'));
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target); // 只触发一次
              }
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
          );
          revealItems.forEach((el) => observer.observe(el));
        }
      }
    </script>
  </body>
</html>
