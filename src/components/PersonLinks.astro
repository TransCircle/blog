---
import type { Person } from '@utils/posts';

export interface Props {
  /** 行首标签，如「作者：」「编辑：」 */
  label: string;
  /** 已规整为 { name, link } 的署名列表 */
  people: Person[];
}

const { label, people } = Astro.props;
---

<div class="person-links">
  <span class="person-links-label">{label}</span>
  <span class="person-links-names">
    {
      people.map((person, index) => (
        <Fragment>
          {index > 0 && (
            <span class="person-links-sep" aria-hidden="true">
              、
            </span>
          )}
          <a
            class="person-link"
            href={person.link}
            target="_blank"
            rel="nofollow noopener noreferrer"
            data-confirm-link
          >
            {person.name}
          </a>
        </Fragment>
      ))
    }
  </span>
</div>

<style>
  .person-links {
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .person-links-label {
    color: var(--text-muted);
  }

  .person-link {
    color: var(--accent-pink);
    font-weight: 500;
    /* 署名是独立成行的链接（前面有「作者：」标签），不必常驻下划线；
       hover / 聚焦时再给线索 */
    text-decoration: none;
    /* 署名可能是较长的外站 ID，必须允许换行以免横向溢出 */
    overflow-wrap: anywhere;
    word-break: break-word;
    transition: color var(--dur-fast) var(--ease-standard);
  }

  .person-link:hover,
  .person-link:focus-visible {
    color: var(--cta-hover);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .person-links-sep {
    color: var(--text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .person-link {
      transition: none;
    }
  }
</style>
