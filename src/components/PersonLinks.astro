---
import type { Person } from '@utils/posts';
import { authorPath } from '@/lib/seo/url';

export interface Props {
  /** 行首标签，如「作者：」「编辑：」 */
  label: string;
  /** 已规整为 { name, link } 的署名列表 */
  people: Person[];
}

const { label, people } = Astro.props;
---

{/* 没有署名就整行不渲染，而不是留下一个孤零零的「编辑：」 */}
{
  people.length > 0 && (
    <div class="person-links">
      <span class="person-links-label">{label}</span>
      <span class="person-links-names">
        {people.map((person, index) => (
          <Fragment>
            {index > 0 && (
              <span class="person-links-sep" aria-hidden="true">
                、
              </span>
            )}
            {/* 署名一律链到站内作者页（该署名的全部文章 + 个人主页链接），
                让「谁写的」落在一个稳定的站内实体上（E-E-A-T），外部主页在作者页与 JSON-LD sameAs 中给出 */}
            <a class="person-link" href={authorPath(person.id)} rel="author">
              {person.name}
            </a>
          </Fragment>
        ))}
      </span>
    </div>
  )
}

<style>
  .person-links {
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .person-links-label {
    color: var(--text-muted);
  }

  .person-link {
    /* 链接一律信息蓝（§5.2 / §7），hover 才转粉文字档 */
    color: var(--blue-600);
    font-weight: var(--fw-medium);
    /* 署名是独立成行的链接（前面有「作者：」标签），不必常驻下划线；
       hover / 聚焦时再给线索 */
    text-decoration: none;
    text-underline-offset: 3px;
    /* 署名可能是较长的外站 ID，必须允许换行以免横向溢出 */
    overflow-wrap: anywhere;
    word-break: break-word;
    transition: color var(--dur-1) var(--ease-standard);
  }

  .person-link:hover,
  .person-link:focus-visible {
    color: var(--pink-700);
    text-decoration: underline;
  }

  .person-links-sep {
    color: var(--text-muted);
  }
</style>
