---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, pubDate, author, category, tags } = post.data;

const formattedDate = new Date(pubDate).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="post-card">
  <div class="post-card-meta">
    <span class="post-card-category">{category}</span>
    <time datetime={pubDate.toISOString()} class="post-card-date">{formattedDate}</time>
  </div>

  <h2 class="post-card-title">
    <a href={`/posts/${post.slug}`} class="post-card-link">{title}</a>
  </h2>

  {description && <p class="post-card-description">{description}</p>}

  <div class="post-card-footer">
    <span class="post-card-author">{author}</span>

    {tags.length > 0 && (
      <div class="post-card-tags">
        {tags.map((tag: string) => (
          <a href={`/tags/${tag}`} class="post-card-tag">#{tag}</a>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .post-card {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--divider-color);
  }

  .post-card:last-child {
    border-bottom: none;
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    font-size: 0.82rem;
  }

  .post-card-category {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    background-color: var(--hover-bg);
    color: var(--accent-pink);
    border-radius: 4px;
    font-weight: 500;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-card-date {
    color: var(--text-muted);
  }

  .post-card-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .post-card-link {
    color: var(--text-main);
    text-decoration: none;
    transition: color 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .post-card-link:hover {
    color: var(--accent-pink);
  }

  .post-card-description {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .post-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .post-card-author {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .post-card-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .post-card-tag {
    color: var(--text-muted);
    font-size: 0.82rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .post-card-tag:hover {
    color: var(--accent-pink);
  }

  @media (max-width: 768px) {
    .post-card-title {
      font-size: 1.2rem;
    }
  }
</style>
