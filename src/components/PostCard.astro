---
import type { CollectionEntry } from 'astro:content';
import type { Person } from '@utils/posts';
import { authorPath, postPath, tagPath } from '@/lib/seo/url';

export interface Props {
  post: CollectionEntry<'posts'>;
  /** 卡片标题的层级：列表页里文章卡片在 h2 小节之下用 h3，独立区块（相关文章）可改 h4 等。 */
  headingLevel?: 'h2' | 'h3' | 'h4';
}

const { post, headingLevel: Heading = 'h3' } = Astro.props;
const { title, description, pubDate, author, category, tags } = post.data;

const formattedDate = new Date(pubDate).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

{/* 卡片视觉全部来自 global.css 的 .post-card-*：搜索页的结果卡由 JS innerHTML 生成，
    拿不到 Astro 的 scoped 属性，两处必须共用同一份全局配方。
    本站文章没有封面图，卡片是纯文字卡（偏离记录见 blog/DESIGN.md）。 */}
<article class="post-card" data-reveal>
  <div class="post-card-top">
    <span class="chip">{category}</span>
    <time class="post-card-date" datetime={pubDate.toISOString()}>{formattedDate}</time>
  </div>

  <Heading class="post-card-title">
    <a href={postPath(post.slug)} rel="bookmark">{title}</a>
  </Heading>

  {description && <p class="post-card-desc">{description}</p>}

  <div class="post-card-foot">
    <span class="post-card-meta">
      {author.map((person: Person, index: number) => (
        <Fragment>
          {index > 0 && <span aria-hidden="true">、</span>}
          {/* 署名链到站内作者页（外部主页在作者页上） */}
          <a href={authorPath(person.id)} rel="author">{person.name}</a>
        </Fragment>
      ))}
    </span>

    {tags.length > 0 && (
      <div class="post-card-tags">
        {tags.map((tag: string) => (
          <a href={tagPath(tag)} class="tag-chip" rel="tag">#{tag}</a>
        ))}
      </div>
    )}
  </div>
</article>
