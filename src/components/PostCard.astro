---
import type { CollectionEntry } from 'astro:content';
import type { Person } from '@utils/posts';
import Pill from '@components/ui/Pill.astro';

export interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, pubDate, author, category, tags } = post.data;

const formattedDate = new Date(pubDate).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="post-row">
  <div class="post-row-meta">
    <Pill tone="accent">{category}</Pill>
    <time datetime={pubDate.toISOString()}>{formattedDate}</time>
  </div>

  <h2 class="post-row-title">
    <a href={`/posts/${post.slug}`}>{title}</a>
  </h2>

  {description && <p class="post-row-desc">{description}</p>}

  <div class="post-row-footer">
    <span class="post-row-authors">
      {author.map((person: Person, index: number) => (
        <Fragment>
          {index > 0 && <span aria-hidden="true">、</span>}
          <a
            class="post-row-author-link"
            href={person.link}
            target="_blank"
            rel="nofollow noopener noreferrer"
            data-confirm-link
          >
            {person.name}
          </a>
        </Fragment>
      ))}
    </span>

    {tags.length > 0 && (
      <div class="post-row-tags">
        {tags.map((tag: string) => (
          <a href={`/tags/${tag}`} class="tag-link">#{tag}</a>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  /* 行的视觉全部来自 global.css 的 .post-row-*；这里只补作者链接：
   * 它比标签低一级，用 --text-muted 而非全局 a 的 accent，避免与 .tag-link 抢注意力。 */
  .post-row-authors {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* 列表行里的作者名：不常驻下划线，hover / 聚焦时才给线索 */
  .post-row-author-link {
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-standard);
  }

  .post-row-author-link:hover,
  .post-row-author-link:focus-visible {
    color: var(--accent-pink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (any-pointer: coarse) {
    .post-row-author-link {
      display: inline-block;
      min-height: var(--tap-min);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-row-author-link {
      transition: none;
    }
  }
</style>
