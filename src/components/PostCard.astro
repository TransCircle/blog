---
import type { CollectionEntry } from 'astro:content';
import type { Person } from '@utils/posts';

export interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, pubDate, author, category, tags } = post.data;

const formattedDate = new Date(pubDate).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

{/* 卡片视觉全部来自 global.css 的 .post-card-*：搜索页的结果卡由 JS innerHTML 生成，
    拿不到 Astro 的 scoped 属性，两处必须共用同一份全局配方。
    本站文章没有封面图，卡片是纯文字卡（偏离记录见 blog/DESIGN.md）。 */}
<article class="post-card" data-reveal>
  <div class="post-card-top">
    <span class="chip">{category}</span>
    <time class="post-card-date" datetime={pubDate.toISOString()}>{formattedDate}</time>
  </div>

  <h3 class="post-card-title">
    <a href={`/posts/${post.slug}`}>{title}</a>
  </h3>

  {description && <p class="post-card-desc">{description}</p>}

  <div class="post-card-foot">
    <span class="post-card-meta">
      {author.map((person: Person, index: number) => (
        <Fragment>
          {index > 0 && <span aria-hidden="true">、</span>}
          {/* 没写 link 的署名保持纯文本，不做跳转 */}
          {person.link ? (
            <a
              href={person.link}
              target="_blank"
              rel="nofollow noopener noreferrer"
              data-confirm-link
            >
              {person.name}
            </a>
          ) : (
            <span>{person.name}</span>
          )}
        </Fragment>
      ))}
    </span>

    {tags.length > 0 && (
      <div class="post-card-tags">
        {tags.map((tag: string) => (
          <a href={`/tags/${tag}`} class="tag-chip">#{tag}</a>
        ))}
      </div>
    )}
  </div>
</article>
