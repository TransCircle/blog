---
/**
 * 外链跳转确认弹窗
 *
 * 拦截页面内带 [data-confirm-link] 的链接点击，弹出二次确认后再在新标签页打开。
 * 渐进增强：未启用 JavaScript 时，链接仍可直接跳转（确认弹窗只是增强层）。
 *
 * 无障碍：role="dialog" + aria-modal，支持 Esc 关闭、Tab 焦点循环、
 * 打开时将主内容设为 inert，关闭后焦点回到触发链接。
 */
---

<div
  id="link-confirm"
  class="link-confirm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="link-confirm-title"
  aria-describedby="link-confirm-desc"
>
  <div class="link-confirm-overlay" data-confirm-dismiss aria-hidden="true"></div>
  <div class="link-confirm-panel">
    <h2 id="link-confirm-title" class="link-confirm-title">即将前往外部链接</h2>
    <p id="link-confirm-desc" class="link-confirm-desc">即将前往以下地址，是否确认跳转？</p>
    <p class="link-confirm-url" id="link-confirm-url"></p>
    <div class="link-confirm-actions">
      <button type="button" class="link-confirm-btn link-confirm-cancel" data-confirm-dismiss>
        取消
      </button>
      <a
        id="link-confirm-go"
        class="link-confirm-btn link-confirm-go"
        href="#"
        target="_blank"
        rel="nofollow noopener noreferrer"
      >
        确认前往
      </a>
    </div>
  </div>
</div>

<script>
  const dialog = document.getElementById('link-confirm');
  const overlay = dialog?.querySelector<HTMLElement>('.link-confirm-overlay');
  const urlText = document.getElementById('link-confirm-url');
  const goLink = document.getElementById('link-confirm-go') as HTMLAnchorElement | null;
  const cancelBtn = dialog?.querySelector<HTMLButtonElement>('.link-confirm-cancel');
  const mainContent = document.getElementById('main-content');

  if (dialog && overlay && urlText && goLink && cancelBtn) {
    let lastFocused: HTMLElement | null = null;
    let isOpen = false;

    function openDialog(url: string, trigger: HTMLElement): void {
      lastFocused = trigger;
      goLink!.href = url;
      urlText!.textContent = url;
      dialog!.classList.add('is-open');
      mainContent?.setAttribute('inert', '');
      document.body.style.overflow = 'hidden';
      isOpen = true;
      goLink!.focus();
    }

    function closeDialog(): void {
      if (!isOpen) return;
      dialog!.classList.remove('is-open');
      mainContent?.removeAttribute('inert');
      document.body.style.overflow = '';
      isOpen = false;
      lastFocused?.focus();
      lastFocused = null;
    }

    // 事件委托：拦截页面内所有带 data-confirm-link 的链接点击
    document.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement | null)?.closest<HTMLAnchorElement>(
        'a[data-confirm-link]'
      );
      if (!link) return;

      // 保留用户用修饰键 / 中键自行在新标签页打开的原生行为
      if (
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey ||
        event.button !== 0
      ) {
        return;
      }

      event.preventDefault();
      openDialog(link.href, link);
    });

    // 确认前往：<a target="_blank"> 由浏览器原生打开新标签页，这里仅关闭弹窗
    goLink.addEventListener('click', () => closeDialog());

    // 取消按钮与遮罩层（均带 data-confirm-dismiss）关闭弹窗
    dialog.querySelectorAll<HTMLElement>('[data-confirm-dismiss]').forEach((el) => {
      el.addEventListener('click', () => closeDialog());
    });

    // 键盘：Esc 关闭；Tab 在「取消 / 确认」之间循环，焦点不外溢
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        closeDialog();
        return;
      }

      if (event.key !== 'Tab') return;

      const focusables: HTMLElement[] = [cancelBtn, goLink];
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (!first || !last) return;

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }
</script>

<style>
  .link-confirm {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    /* 默认隐藏：visibility:hidden 同时移出无障碍树与 Tab 顺序，无需 JS 即安全 */
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease;
  }

  .link-confirm.is-open {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }

  .link-confirm-overlay {
    position: absolute;
    inset: 0;
    background-color: var(--overlay-bg);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .link-confirm-panel {
    position: relative;
    width: 100%;
    max-width: 420px;
    padding: 1.75rem;
    background-color: var(--bg-color);
    border: 1px solid var(--divider-color);
    border-radius: 16px;
    box-shadow:
      0 0 10px var(--shadow-color),
      0 8px 28px rgba(0, 0, 0, 0.12);
    transform: translateY(8px) scale(0.98);
    transition: transform 0.2s ease;
  }

  .link-confirm.is-open .link-confirm-panel {
    transform: none;
  }

  .link-confirm-title {
    margin-bottom: 0.5rem;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .link-confirm-desc {
    margin-bottom: 0.75rem;
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  .link-confirm-url {
    margin-bottom: 1.5rem;
    padding: 0.65rem 0.85rem;
    background-color: var(--hover-bg);
    border: 1px solid var(--divider-color);
    border-radius: 8px;
    color: var(--accent-pink);
    font-family: 'SF Mono', Monaco, 'Cascadia Code', Consolas, monospace;
    font-size: 0.85rem;
    word-break: break-all;
  }

  .link-confirm-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .link-confirm-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1.2rem;
    border-radius: 50px;
    font-size: 0.875rem;
    font-weight: 500;
    font-family: inherit;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .link-confirm-btn:focus-visible {
    outline: 2px solid var(--primary-pink);
    outline-offset: 2px;
  }

  .link-confirm-cancel {
    background: none;
    border: 1.5px solid var(--primary-pink);
    color: var(--primary-pink);
  }

  .link-confirm-cancel:hover {
    background-color: var(--hover-bg);
    border-color: var(--accent-pink);
    color: var(--accent-pink);
  }

  .link-confirm-go {
    border: 1.5px solid transparent;
    background-color: var(--accent-pink);
    color: white;
    box-shadow: 0 2px 8px var(--shadow-color-hover);
  }

  .link-confirm-go:hover {
    color: white;
    /* color-mix 平滑变暗，附带硬编码回退（与 DESIGN.md 一致） */
    background-color: var(--cta-hover);
    background-color: var(--cta-hover-mix);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px var(--shadow-color-hover);
  }

  @media (max-width: 480px) {
    .link-confirm-actions {
      flex-direction: column-reverse;
    }

    .link-confirm-btn {
      width: 100%;
    }
  }
</style>
