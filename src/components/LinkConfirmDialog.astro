---
/**
 * 外链跳转确认弹窗
 *
 * 拦截页面内带 [data-confirm-link] 的链接点击，弹出二次确认后再在新标签页打开。
 * 渐进增强：未启用 JavaScript 时，链接仍可直接跳转（确认弹窗只是增强层）。
 *
 * 无障碍：role="dialog" + aria-modal，支持 Esc 关闭、Tab 焦点循环、
 * 打开时将主内容设为 inert，关闭后焦点回到触发链接。
 */
import Button from './ui/Button.astro';
---

<div
  id="link-confirm"
  class="link-confirm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="link-confirm-title"
  aria-describedby="link-confirm-desc"
>
  <div class="link-confirm-overlay" data-confirm-dismiss aria-hidden="true"></div>
  <div class="link-confirm-panel">
    <h2 id="link-confirm-title" class="link-confirm-title">即将前往外部链接</h2>
    <p id="link-confirm-desc" class="link-confirm-desc">即将前往以下地址，是否确认跳转？</p>
    <p class="link-confirm-url" id="link-confirm-url"></p>
    <div class="link-confirm-actions">
      {/* 类名 link-confirm-cancel / link-confirm-go 是脚本的查询锚点，勿改 */}
      <Button variant="secondary" class="link-confirm-cancel" data-confirm-dismiss>
        取消
      </Button>
      <Button
        variant="primary"
        href="#"
        id="link-confirm-go"
        class="link-confirm-go"
        target="_blank"
        rel="nofollow noopener noreferrer"
      >
        确认前往
      </Button>
    </div>
  </div>
</div>

<script>
  const dialog = document.getElementById('link-confirm');
  const overlay = dialog?.querySelector<HTMLElement>('.link-confirm-overlay');
  const urlText = document.getElementById('link-confirm-url');
  const goLink = document.getElementById('link-confirm-go') as HTMLAnchorElement | null;
  const cancelBtn = dialog?.querySelector<HTMLButtonElement>('.link-confirm-cancel');
  const mainContent = document.getElementById('main-content');

  if (dialog && overlay && urlText && goLink && cancelBtn) {
    let lastFocused: HTMLElement | null = null;
    let isOpen = false;

    // 弹窗声明了 aria-modal，背景就必须整体退出无障碍树：只冻结 <main> 的话，
    // 顶栏、页脚仍能被读屏的虚拟光标浏览到，也仍可被程序聚焦。
    const inertTargets = (): (Element | null)[] => [
      mainContent,
      document.querySelector('.site-header'),
      document.querySelector('.site-footer'),
    ];

    function openDialog(url: string, trigger: HTMLElement): void {
      lastFocused = trigger;
      goLink!.href = url;
      urlText!.textContent = url;
      dialog!.classList.add('is-open');
      inertTargets().forEach((el) => el?.setAttribute('inert', ''));
      document.body.style.overflow = 'hidden';
      isOpen = true;
      goLink!.focus();
    }

    function closeDialog(): void {
      if (!isOpen) return;
      dialog!.classList.remove('is-open');
      // 先解除 inert 再归还焦点：触发链接可能就在顶栏/页脚里
      inertTargets().forEach((el) => el?.removeAttribute('inert'));
      document.body.style.overflow = '';
      isOpen = false;
      lastFocused?.focus();
      lastFocused = null;
    }

    // 事件委托：拦截页面内所有带 data-confirm-link 的链接点击
    document.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement | null)?.closest<HTMLAnchorElement>(
        'a[data-confirm-link]'
      );
      if (!link) return;

      // 保留用户用修饰键 / 中键自行在新标签页打开的原生行为
      if (
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey ||
        event.button !== 0
      ) {
        return;
      }

      event.preventDefault();
      openDialog(link.href, link);
    });

    // 确认前往：<a target="_blank"> 由浏览器原生打开新标签页，这里仅关闭弹窗
    goLink.addEventListener('click', () => closeDialog());

    // 取消按钮与遮罩层（均带 data-confirm-dismiss）关闭弹窗
    dialog.querySelectorAll<HTMLElement>('[data-confirm-dismiss]').forEach((el) => {
      el.addEventListener('click', () => closeDialog());
    });

    // 键盘：Esc 关闭；Tab 在「取消 / 确认」之间循环，焦点不外溢
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        closeDialog();
        return;
      }

      if (event.key !== 'Tab') return;

      const focusables: HTMLElement[] = [cancelBtn, goLink];
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (!first || !last) return;

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }
</script>

<style>
  .link-confirm {
    position: fixed;
    inset: 0;
    /* 模态层：压住顶栏（--z-nav）与抽屉（--z-drawer） */
    z-index: var(--z-modal);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--s-5);
    /* 默认隐藏：visibility:hidden 同时移出无障碍树与 Tab 顺序，无需 JS 即安全 */
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--dur-2) var(--ease-standard),
      visibility var(--dur-2) var(--ease-standard);
  }

  .link-confirm.is-open {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }

  .link-confirm-overlay {
    position: absolute;
    inset: 0;
    background-color: var(--overlay);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  /* 面板走实色 --surface（§5.7 允许 --surface 或玻璃；这里面板承载 URL 文本，
   * 实色可读性更好），--r-lg + --shadow-3，入场 scale(.96→1)。 */
  .link-confirm-panel {
    position: relative;
    width: 100%;
    max-width: 420px;
    /* dvh：移动端地址栏收起时不被裁切；内容超高时面板自身滚动 */
    max-height: calc(100dvh - 3rem);
    overflow-y: auto;
    min-width: 0;
    padding: var(--s-5);
    background-color: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-3);
    transform: scale(0.96);
    transition: transform var(--dur-2) var(--ease-out);
  }

  .link-confirm.is-open .link-confirm-panel {
    transform: none;
  }

  .link-confirm-title {
    margin-bottom: var(--s-2);
    font-size: var(--fs-h3);
    font-weight: var(--fw-bold);
    color: var(--ink);
  }

  .link-confirm-desc {
    margin-bottom: var(--s-3);
    font-size: var(--fs-body);
    color: var(--text-secondary);
  }

  /* URL 展示为代码块：任意长度都必须能断行，弹窗不得横向溢出。
   * 用凹陷面而非粉底——这里是待确认的外部地址，不该被读成品牌强调。 */
  .link-confirm-url {
    margin-bottom: var(--s-5);
    padding: 0.55rem 0.75rem;
    min-width: 0;
    background-color: var(--surface-2);
    border-radius: var(--r-xs);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .link-confirm-actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--s-2);
    flex-wrap: wrap;
  }

  @media (max-width: 480px) {
    .link-confirm-actions {
      flex-direction: column-reverse;
    }

    /* :global 是必需的：按钮由 Button 组件渲染，不带本组件的作用域标记 */
    .link-confirm-actions :global(.btn) {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .link-confirm,
    .link-confirm-panel {
      transition: none;
    }

    .link-confirm-panel {
      transform: none;
    }
  }
</style>
