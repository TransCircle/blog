---
/**
 * 脚注容器组件
 * 用于在文章末尾渲染脚注内容
 * 支持「注释」和「引用资料」两个分类
 */

export interface FootnoteItem {
  id: string;
  type: 'annotation' | 'reference';
  content: string;
  url?: string;
}

export interface Props {
  footnotes: FootnoteItem[];
}

const { footnotes } = Astro.props;

// 分离注释和引用资料
const annotations = footnotes.filter(fn => fn.type === 'annotation');
const references = footnotes.filter(fn => fn.type === 'reference');
---

<section class="footnotes-section" aria-label="脚注">
  {annotations.length > 0 && (
    <div class="footnotes-group">
      <h3 class="footnotes-title">注释</h3>
      <ol class="footnotes-list annotations-list">
        {annotations.map(({ id, content, url }) => (
          <li id={`footnote-${id}`} class="footnote-item">
            <span class="footnote-content">
              {content}
              {url && (
                <> <a href={url} target="_blank" rel="noopener noreferrer" class="footnote-url">{url}</a></>
              )}
            </span>
            <a href={`#footnote-ref-${id}`} class="footnote-backref" aria-label={`返回注释 ${id}`}>↩</a>
          </li>
        ))}
      </ol>
    </div>
  )}

  {references.length > 0 && (
    <div class="footnotes-group">
      <h3 class="footnotes-title">引用资料</h3>
      <ol class="footnotes-list references-list">
        {references.map(({ id, content, url }) => (
          <li id={`footnote-${id}`} class="footnote-item">
            <span class="footnote-content">
              {content}
              {url && (
                <> <a href={url} target="_blank" rel="noopener noreferrer" class="footnote-url">{url}</a></>
              )}
            </span>
            <a href={`#footnote-ref-${id}`} class="footnote-backref" aria-label={`返回引用 ${id}`}>↩</a>
          </li>
        ))}
      </ol>
    </div>
  )}
</section>

<style>
  .footnotes-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 2px solid var(--divider-color);
    font-size: 0.9rem;
  }

  .footnotes-group {
    margin-bottom: 2rem;
  }

  .footnotes-group:last-child {
    margin-bottom: 0;
  }

  .footnotes-title {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .footnotes-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footnote-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.75rem;
    padding: 0.5rem;
    border-radius: 4px;
    transition: background-color 0.2s ease;
  }

  .footnote-item:hover {
    background-color: var(--hover-bg);
  }

  .footnote-item:target {
    background-color: var(--soft-pink);
    border-left: 3px solid var(--accent-pink);
    padding-left: calc(0.5rem - 3px);
  }

  .annotations-list .footnote-item:target {
    border-left-color: var(--accent-pink);
  }

  .references-list .footnote-item:target {
    border-left-color: #0066cc;
    background-color: #e6f2ff;
  }

  .footnote-content {
    flex: 1;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .footnote-url {
    display: inline-block;
    color: #0066cc;
    text-decoration: underline;
    word-break: break-all;
    margin-left: 0.25em;
  }

  .footnote-url:hover {
    color: #0052a3;
  }

  .footnote-backref {
    flex-shrink: 0;
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    border-radius: 3px;
    transition: all 0.2s ease;
  }

  .footnote-backref:hover {
    background-color: var(--soft-pink);
    color: var(--accent-pink);
  }

  @media (max-width: 768px) {
    .footnote-item {
      flex-direction: column;
      gap: 0.5rem;
    }

    .footnote-backref {
      align-self: flex-start;
    }
  }
</style>
