---
// 单按钮双态主题切换（浅色 ↔ 深色）。
// 关键约束：本按钮绝不能带 data-theme 属性——theme.css 的选择器会匹配到它，
// 导致按钮自身重新声明整套主题变量（历史 bug TH-1）。状态一律走 .icon-wrap 上的 data-dark。
---

<button type="button" class="theme-toggle" aria-label="切换到深色模式">
  <span class="icon-wrap" aria-hidden="true">
    <span class="icon icon-moon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </span>
    <span class="icon icon-sun">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="5"/>
        <line x1="12" y1="1" x2="12" y2="3"/>
        <line x1="12" y1="21" x2="12" y2="23"/>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
        <line x1="1" y1="12" x2="3" y2="12"/>
        <line x1="21" y1="12" x2="23" y2="12"/>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
      </svg>
    </span>
  </span>
</button>

<script>
  const VALID = ['light', 'dark'] as const;
  type Theme = (typeof VALID)[number];

  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const iconWrap = btn?.querySelector<HTMLElement>('.icon-wrap');
  const html = document.documentElement;

  if (btn && iconWrap) {
    const button = btn;
    const wrap = iconWrap;

    const isTheme = (t: string | null): t is Theme =>
      t !== null && (VALID as readonly string[]).includes(t);
    const validate = (t: string | null): Theme => (isTheme(t) ? t : 'light');

    // aria-label 描述“点击后会发生什么”，而不是当前状态
    function syncButton(theme: Theme) {
      const isDark = theme === 'dark';
      if (isDark) {
        wrap.setAttribute('data-dark', '');
      } else {
        wrap.removeAttribute('data-dark');
      }
      button.setAttribute('aria-label', isDark ? '切换到浅色模式' : '切换到深色模式');
    }

    function setTheme(next: string | null) {
      const theme = validate(next);
      // 存储可能被禁用（隐私模式 / 沙箱 iframe），抛异常也不能影响本次切换生效
      try {
        localStorage.setItem('transcircle-theme', theme);
      } catch {
        /* 存不下就只在本次会话内生效 */
      }
      html.setAttribute('data-theme', theme); // 唯一的 DOM 副作用
      syncButton(theme);
    }

    // 启动时只读不写：Layout 的 boot 脚本已按 localStorage / 系统偏好写好 data-theme
    syncButton(validate(html.getAttribute('data-theme')));

    btn.addEventListener('click', () => {
      setTheme(html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
    });
  }
</script>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    width: var(--control-h);
    height: var(--control-h);
    padding: 0;
    border: none;
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard),
      transform var(--dur-fast) var(--ease-standard);
  }

  .theme-toggle:hover {
    background-color: var(--hover-bg);
    color: var(--primary-pink);
  }

  .theme-toggle:active {
    transform: scale(0.9);
  }

  /* 粗指针下把按钮本体保持 34px，靠伪元素撑出 44px 命中区，避免顶栏变高 */
  @media (any-pointer: coarse) {
    .theme-toggle::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: var(--tap-min);
      height: var(--tap-min);
      transform: translate(-50%, -50%);
    }
  }

  .icon-wrap {
    position: relative;
    display: block;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      opacity var(--dur-base) var(--ease-standard),
      transform 340ms var(--ease-emphasized);
  }

  .icon-moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .icon-sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }

  .icon-wrap[data-dark] .icon-moon {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }

  .icon-wrap[data-dark] .icon-sun {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .icon {
      transition: none;
    }

    .theme-toggle:active {
      transform: none;
    }
  }
</style>
