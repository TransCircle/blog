---
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { href: '/', label: '首页' },
  { href: '/tags', label: '标签' },
  { href: '/search', label: '搜索' },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => href === '/tags'
  ? currentPath === href || currentPath.startsWith('/tags/')
  : currentPath === href;
---

<header class="site-header" role="banner">
  <div class="header-container">
    <a href="/" class="logo" aria-label="TransCircle Blog 首页">
      <img class="logo-image logo-image-light" src="/brand/transcircle-horizontal-on-light.svg" width="400" height="120" alt="" aria-hidden="true" />
      <img class="logo-image logo-image-dark" src="/brand/transcircle-horizontal-on-dark.svg" width="400" height="120" alt="" aria-hidden="true" />
    </a>

    <nav class="main-nav" aria-label="主导航">
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="nav-link" aria-current={isCurrent(link.href) ? 'page' : undefined}>
              {link.label}
              {/* 当前项指示条：24×3px 迷你旗帜条纹（DESIGN §3.1 / §5.3），
                  非当前项不渲染，导航里最多出现一条 */}
              {isCurrent(link.href) && (
                <span class="flag-stripe flag-stripe-mini nav-flag" aria-hidden="true">
                  <span></span><span></span><span></span>
                </span>
              )}
            </a>
          </li>
        ))}

        {/* 竖线把「站内功能」和「离开本站」分开：横排导航里只有竖线能起到分隔作用 */}
        <li class="nav-sep" role="separator" aria-orientation="vertical"></li>

        <li>
          <a
            href="https://transcircle.org"
            class="nav-link nav-link-external"
            target="_blank"
            rel="noopener noreferrer"
          >
            主站
            <svg class="ext-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M7 17 17 7"/>
              <path d="M8 7h9v9"/>
            </svg>
            <span class="sr-only">（在新标签页打开 TransCircle 主站）</span>
          </a>
        </li>
      </ul>
    </nav>

    {/* 主题开关与汉堡按钮同属一组：移动端二者紧挨在右上角 */}
    <div class="header-actions">
      <ThemeToggle />

      <button
        class="mobile-menu-toggle"
        aria-label="打开导航菜单"
        aria-expanded="false"
        aria-controls="mobile-menu"
        type="button"
      >
        <span class="hamburger" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

{/* 抽屉必须放在 <header> 外面：顶栏带 backdrop-filter，会成为 position: fixed
    子元素的包含块，抽屉的 top/bottom 会相对顶栏解析——之前它就被压成了顶栏那一条。 */}
<div id="mobile-menu" class="mobile-menu" role="dialog" aria-label="移动端导航菜单" aria-modal="true">
  <div class="mobile-menu-overlay"></div>
  <div class="mobile-menu-panel">
    <div class="mobile-menu-header">
      <div class="mobile-menu-brand" aria-hidden="true">
        <img class="logo-image logo-image-light" src="/brand/transcircle-horizontal-on-light.svg" width="400" height="120" alt="" />
        <img class="logo-image logo-image-dark" src="/brand/transcircle-horizontal-on-dark.svg" width="400" height="120" alt="" />
      </div>
      <button class="mobile-menu-close" aria-label="关闭导航菜单" type="button">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <nav aria-label="移动端主导航">
      <ul class="mobile-nav-list">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="mobile-nav-link" aria-current={currentPath === link.href ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}

        {/* 纵向堆叠的抽屉里，分隔线只能是横线 */}
        <li class="mobile-nav-divider" role="separator"></li>

        <li>
          <a
            href="https://transcircle.org"
            class="mobile-nav-link mobile-nav-link-external"
            target="_blank"
            rel="noopener noreferrer"
          >
            主站
            <svg class="ext-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M7 17 17 7"/>
              <path d="M8 7h9v9"/>
            </svg>
            <span class="sr-only">（在新标签页打开 TransCircle 主站）</span>
          </a>
        </li>
      </ul>
    </nav>
    {/* 抽屉内补主题开关：抽屉打开时顶栏（含主题按钮）被遮罩盖住，没有它移动端无法在菜单打开时切换主题。 */}
    <div class="mobile-menu-theme">
      <ThemeToggle />
    </div>
  </div>
</div>

<script>
  // 导航折叠断点：必须与本文件 CSS 中的 1200px 保持一致（DESIGN §4：1200 导航折叠）
  const MOBILE_BREAKPOINT = 1200;

  const siteHeader = document.querySelector('.site-header');
  const menuToggle = document.querySelector('.mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuClose = document.querySelector('.mobile-menu-close');
  const menuOverlay = document.querySelector('.mobile-menu-overlay');
  const mainContent = document.getElementById('main-content');

  const isOpen = () => mobileMenu?.classList.contains('is-open') ?? false;

  // 抽屉声明了 aria-modal，焦点就必须真的被关在里面。只冻结 main 是不够的：
  // 顶栏内条（logo / 主站 CTA / 主题开关）与整个页脚仍在 Tab 序里，
  // Tab 走到最后一个抽屉链接后会溜到遮罩背后的页面上。
  const inertTargets = () => [
    mainContent,
    document.querySelector('.header-container'),
    document.querySelector('.site-footer'),
  ];

  function openMenu() {
    if (isOpen()) return;
    mobileMenu?.classList.add('is-open');
    menuToggle?.classList.add('is-active');
    menuToggle?.setAttribute('aria-expanded', 'true');
    menuToggle?.setAttribute('aria-label', '关闭导航菜单');
    // 只冻结 header 容器内的「非汉堡」部分：汉堡留在 inert 之外，
    // 抽屉打开时仍是「再点一次关闭」的可见出口（X 态不是死状态）。
    inertTargets().forEach((el) => {
      if (el?.classList.contains('header-container')) {
        Array.from(el.children).forEach((child) => {
          if (child.classList.contains('header-actions')) {
            Array.from(child.children).forEach((action) => {
              if (!action.classList.contains('mobile-menu-toggle')) action.setAttribute('inert', '');
            });
          } else {
            child.setAttribute('inert', '');
          }
        });
      } else {
        el?.setAttribute('inert', '');
      }
    });
    document.body.style.overflow = 'hidden';
    // 等面板滑入视口后再移焦，避免焦点落在屏幕外；reduced-motion 下立即移焦。
    const delay = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 200;
    focusTimer = window.setTimeout(() => {
      const firstLink = mobileMenu?.querySelector('.mobile-nav-link');
      if (isOpen() && firstLink instanceof HTMLElement) firstLink.focus();
    }, delay);
  }

  // 移焦定时器：closeMenu 必须清掉——否则 200ms 内关抽屉会把焦点
  // 塞回一个已 visibility:hidden 的链接（焦点掉到 body）。
  let focusTimer: number | null = null;

  function closeMenu() {
    if (!isOpen()) return;
    if (focusTimer !== null) {
      window.clearTimeout(focusTimer);
      focusTimer = null;
    }
    mobileMenu?.classList.remove('is-open');
    menuToggle?.classList.remove('is-active');
    menuToggle?.setAttribute('aria-expanded', 'false');
    menuToggle?.setAttribute('aria-label', '打开导航菜单');
    // 必须先解除 inert 再归还焦点：汉堡按钮就在 .header-container 里，
    // 仍处于 inert 时 focus() 是无效的。
    inertTargets().forEach((el) => {
      if (el?.classList.contains('header-container')) {
        el.querySelectorAll('[inert]').forEach((child) => child.removeAttribute('inert'));
      } else {
        el?.removeAttribute('inert');
      }
    });
    document.body.style.overflow = '';
    // 若因视口变宽而关闭，按钮已 display:none，则不抢焦点
    if (menuToggle instanceof HTMLElement && menuToggle.offsetParent !== null) {
      menuToggle.focus();
    }
  }

  // 汉堡改为 toggle 语义：抽屉开着时再点一次即关闭。
  menuToggle?.addEventListener('click', () => {
    if (isOpen()) closeMenu();
    else openMenu();
  });
  menuClose?.addEventListener('click', closeMenu);
  menuOverlay?.addEventListener('click', closeMenu);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) closeMenu();
  });

  // 焦点陷阱：inert 只能冻结 header / main / footer，而 skip-link 挂在 body 上，
  // Tab 走到抽屉最后一项后仍会跳到它。声明了 aria-modal 就必须真正闭环，
  // 所以在抽屉内做 Tab 循环。
  const menuPanel = mobileMenu?.querySelector('.mobile-menu-panel');

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || !isOpen() || !menuPanel) return;

    const focusables = Array.from(
      menuPanel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')
    ).filter((el) => el.offsetParent !== null);
    if (focusables.length === 0) return;

    const first = focusables[0]!;
    const last = focusables[focusables.length - 1]!;
    const active = document.activeElement;

    if (e.shiftKey && (active === first || !menuPanel.contains(active))) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && (active === last || !menuPanel.contains(active))) {
      e.preventDefault();
      first.focus();
    }
  });

  // 点击抽屉内链接后关闭（同页锚点不会触发导航，故同时监听 hashchange）
  mobileMenu?.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
  window.addEventListener('hashchange', closeMenu);

  // 视口回到桌面宽度时抽屉必须自动关闭：否则遮罩与 inert 会残留在无汉堡按钮的布局里
  window.addEventListener('resize', () => {
    if (window.innerWidth > MOBILE_BREAKPOINT) closeMenu();
  });

  // 把顶栏真实高度写进 --app-nav-height，供 scroll-margin / 阅读进度条消费
  if (siteHeader) {
    const syncNavHeight = () => {
      const height = Math.ceil(siteHeader.getBoundingClientRect().height);
      document.documentElement.style.setProperty('--app-nav-height', `${height}px`);
    };
    syncNavHeight();
    new ResizeObserver(syncNavHeight).observe(siteHeader);
  }
</script>

<style>
  /* 顶栏是浮动层，按 §1.4 / §5.3 走玻璃：--glass-bg + blur(--glass-blur) + 底部 1px --line。
   * 不投影——分层靠那条线与玻璃本身。 */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    display: flex;
    align-items: center;
    min-height: var(--nav-h);
    background-color: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    border-bottom: 1px solid var(--line);
  }

  /* §2.5 强制要求的玻璃回退：不支持 backdrop-filter 时退成实色面，
   * 否则半透明底叠在滚动内容上会糊成一团。 */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header {
      background-color: var(--surface);
    }
  }

  /* 外壳轨道 --w-content，与页脚内条共用同一条水平内边距表达式（§4） */
  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    width: 100%;
    max-width: var(--w-content);
    margin-inline: auto;
    padding: var(--s-2) var(--page-x);
    min-height: var(--nav-h);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    height: 40px;
    text-decoration: none;
  }

  .logo-image {
    display: block;
    width: 132px;
    height: auto;
  }

  .logo-image-dark {
    display: none;
  }

  :global([data-theme='dark']) .logo-image-light {
    display: none;
  }

  :global([data-theme='dark']) .logo-image-dark {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .logo-image-light {
      display: none;
    }

    :global(:root:not([data-theme])) .logo-image-dark {
      display: block;
    }
  }

  .main-nav {
    display: block;
    min-width: 0;
  }

  .nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    gap: var(--s-1);
    margin: 0;
    padding: 0;
  }

  /* 站内功能 ↔ 外站入口的分隔：横排导航里只有竖线能分隔 */
  .nav-sep {
    width: 1px;
    height: 18px;
    margin: 0 var(--s-2);
    background-color: var(--line);
    flex-shrink: 0;
  }

  /* 外站入口：与同组链接同色，「会离开本站」由 ↗ 图标表达，
     而不是把文字调灰——调灰会被读成禁用态 */
  .nav-link-external {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
  }

  .ext-icon {
    flex-shrink: 0;
    color: var(--text-muted);
  }

  .nav-link-external:hover .ext-icon,
  .mobile-nav-link-external:hover .ext-icon {
    color: inherit;
  }

  /* 导航链接不设下划线，当前态用迷你旗帜条纹（§5.2 / §5.3）。
   * position: relative 是条纹的定位基准；底部内边距给条纹让位。 */
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: var(--s-2) var(--s-3) calc(var(--s-2) + 3px);
    color: var(--text-secondary);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    text-decoration: none;
    border-radius: var(--r-sm);
    transition: color var(--dur-1) var(--ease-standard);
  }

  .nav-link:hover {
    color: var(--pink-700);
  }

  .nav-link[aria-current='page'] {
    color: var(--ink);
  }

  .nav-flag {
    position: absolute;
    left: 50%;
    bottom: 2px;
    transform: translateX(-50%);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    flex-shrink: 0;
  }

  .mobile-menu-toggle {
    position: relative;
    z-index: 1; /* 顶栏内部的层级即可；抽屉整体已在顶栏之上 */
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 8px;
    background: none;
    border: none;
    border-radius: var(--r-sm);
    cursor: pointer;
    color: var(--ink);
    transition: background-color var(--dur-1) var(--ease-standard);
  }

  .mobile-menu-toggle:hover {
    background-color: var(--pink-100);
  }

  .hamburger {
    display: block;
    position: relative;
    width: 20px;
    height: 2px;
    background-color: currentColor;
    border-radius: var(--r-xs);
    transition: background-color var(--dur-1) var(--ease-standard);
  }

  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: currentColor;
    border-radius: var(--r-xs);
    transition: transform var(--dur-2) var(--ease-out);
  }

  .hamburger::before {
    top: -6px;
  }

  .hamburger::after {
    top: 6px;
  }

  /* 汉堡 → X：中杠隐去，上下杠平移到中线后旋转。
   * 中杠必须用 background-color: transparent 而非 opacity: 0——
   * opacity 作用于整个元素，会把承载 X 两笔的 ::before/::after 一起变透明，
   * 按钮在打开态就成了一块空白。 */
  .mobile-menu-toggle.is-active .hamburger {
    background-color: transparent;
  }

  .mobile-menu-toggle.is-active .hamburger::before {
    transform: translateY(6px) rotate(45deg);
  }

  .mobile-menu-toggle.is-active .hamburger::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* 抽屉：用 visibility 而非 display 切换，进场/退场动画都能播完，
   * 且 visibility: hidden 会使内部链接退出焦点序列（display 切换做不到动画） */
  .mobile-menu {
    visibility: hidden;
    transition: visibility 0s linear var(--dur-2);
  }

  .mobile-menu.is-open {
    visibility: visible;
    transition-delay: 0s;
  }

  .mobile-menu-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay); /* 抽屉已移出 header，必须压过顶栏的 --z-nav */
    background-color: var(--overlay);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-2) var(--ease-out);
  }

  .mobile-menu.is-open .mobile-menu-overlay {
    opacity: 1;
    pointer-events: auto;
  }

  /* §5.3：抽屉自**右侧**滑入，玻璃面板 + --r-lg（贴边的两角保持直角） */
  .mobile-menu-panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: var(--z-drawer); /* 面板在遮罩之上 */
    width: 280px;
    max-width: 84vw;
    padding: var(--s-5);
    background-color: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    border-left: 1px solid var(--glass-border);
    border-radius: var(--r-lg) 0 0 var(--r-lg);
    box-shadow: var(--shadow-3);
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform var(--dur-2) var(--ease-out);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .mobile-menu-panel {
      background-color: var(--surface);
    }
  }

  .mobile-menu.is-open .mobile-menu-panel {
    transform: translateX(0);
  }

  .mobile-menu-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--s-4);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--line);
  }

  .mobile-menu-brand {
    display: inline-flex;
    align-items: center;
    height: 40px;
  }

  .mobile-menu-theme {
    margin-top: var(--s-4);
    padding-top: var(--s-3);
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: flex-end;
  }

  .mobile-menu-close {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    padding: 0;
    background: none;
    border: none;
    border-radius: var(--r-sm);
    cursor: pointer;
    color: var(--text-secondary);
    transition:
      background-color var(--dur-1) var(--ease-standard),
      color var(--dur-1) var(--ease-standard);
  }

  .mobile-menu-close:hover {
    background-color: var(--pink-100);
    color: var(--ink);
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  /* 链接逐个 40ms 交错上浮入场（§5.3）。关闭态即初始态，
   * reduced-motion 下过渡被全局关掉，只剩终态跳变，不会卡在 opacity: 0。 */
  .mobile-nav-list li {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .mobile-menu.is-open .mobile-nav-list li {
    opacity: 1;
    transform: none;
  }

  .mobile-menu.is-open .mobile-nav-list li:nth-child(1) {
    transition-delay: 40ms;
  }

  .mobile-menu.is-open .mobile-nav-list li:nth-child(2) {
    transition-delay: 80ms;
  }

  .mobile-menu.is-open .mobile-nav-list li:nth-child(3) {
    transition-delay: 120ms;
  }

  .mobile-menu.is-open .mobile-nav-list li:nth-child(4) {
    transition-delay: 160ms;
  }

  .mobile-menu.is-open .mobile-nav-list li:nth-child(5) {
    transition-delay: 200ms;
  }

  .mobile-nav-link {
    display: block;
    padding: var(--s-3) var(--s-4);
    color: var(--text-body);
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    text-decoration: none;
    border-radius: var(--r-sm);
    transition:
      background-color var(--dur-1) var(--ease-standard),
      color var(--dur-1) var(--ease-standard);
  }

  .mobile-nav-link:hover {
