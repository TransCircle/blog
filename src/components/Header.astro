---
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { href: '/', label: '首页' },
  { href: '/tags', label: '标签' },
  { href: '/search', label: '搜索' },
];
---

<header class="site-header" role="banner">
  <div class="header-container">
    <a href="/" class="logo" aria-label="Oakley HuangBlog 首页">
      <!-- 品牌图标：src/assets/brand/ → public/，由 scripts/generate-icons.mjs 生成 -->
      <img class="logo-mark" src="/logo-mark.svg" width="28" height="28" alt="" aria-hidden="true" />
      <span class="logo-text">TransCircle</span>
    </a>

    <nav class="main-nav" aria-label="主导航">
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="nav-link" aria-current={Astro.url.pathname === link.href ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}

        {/* 竖线把「站内功能」和「离开本站」分开：横排导航里只有竖线能起到分隔作用 */}
        <li class="nav-sep" role="separator" aria-orientation="vertical"></li>

        <li>
          <a
            href="https://transcircle.org"
            class="nav-link nav-link-external"
            target="_blank"
            rel="noopener noreferrer"
          >
            主站
            <svg class="ext-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M7 17 17 7"/>
              <path d="M8 7h9v9"/>
            </svg>
            <span class="sr-only">（在新标签页打开 Oakley Huang主站）</span>
          </a>
        </li>
      </ul>
    </nav>

    {/* 主题开关与汉堡按钮同属一组：移动端二者紧挨在右上角 */}
    <div class="header-actions">
      <ThemeToggle />

      <button
        class="mobile-menu-toggle"
        aria-label="打开导航菜单"
        aria-expanded="false"
        aria-controls="mobile-menu"
        type="button"
      >
        <span class="hamburger" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

{/* 抽屉必须放在 <header> 外面：顶栏带 backdrop-filter，会成为 position: fixed
    子元素的包含块，抽屉的 top/bottom 会相对顶栏解析——之前它就被压成了顶栏那一条。 */}
<div id="mobile-menu" class="mobile-menu" role="dialog" aria-label="移动端导航菜单" aria-modal="true">
  <div class="mobile-menu-overlay"></div>
  <div class="mobile-menu-panel">
    {/* 抽屉不需要「菜单」这种自我说明的标题，只留一个关闭按钮 */}
    <div class="mobile-menu-header">
      <button class="mobile-menu-close" aria-label="关闭导航菜单" type="button">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <nav aria-label="移动端主导航">
      <ul class="mobile-nav-list">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="mobile-nav-link" aria-current={Astro.url.pathname === link.href ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}

        {/* 纵向堆叠的抽屉里，分隔线只能是横线 */}
        <li class="mobile-nav-divider" role="separator"></li>

        <li>
          <a
            href="https://transcircle.org"
            class="mobile-nav-link mobile-nav-link-external"
            target="_blank"
            rel="noopener noreferrer"
          >
            主站
            <svg class="ext-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M7 17 17 7"/>
              <path d="M8 7h9v9"/>
            </svg>
            <span class="sr-only">（在新标签页打开 Oakley Huang主站）</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</div>

<script>
  // 移动端断点：必须与本文件 CSS 中的 1100px 保持一致（唯一的导航断点）
  const MOBILE_BREAKPOINT = 1100;

  const siteHeader = document.querySelector('.site-header');
  const menuToggle = document.querySelector('.mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuClose = document.querySelector('.mobile-menu-close');
  const menuOverlay = document.querySelector('.mobile-menu-overlay');
  const mainContent = document.getElementById('main-content');

  const isOpen = () => mobileMenu?.classList.contains('is-open') ?? false;

  // 抽屉声明了 aria-modal，焦点就必须真的被关在里面。只冻结 main 是不够的：
  // 顶栏内条（logo / 主站 CTA / 主题开关）与整个页脚仍在 Tab 序里，
  // Tab 走到最后一个抽屉链接后会溜到遮罩背后的页面上。
  const inertTargets = () => [
    mainContent,
    document.querySelector('.header-container'),
    document.querySelector('.site-footer'),
  ];

  function openMenu() {
    if (isOpen()) return;
    mobileMenu?.classList.add('is-open');
    menuToggle?.classList.add('is-active');
    menuToggle?.setAttribute('aria-expanded', 'true');
    inertTargets().forEach((el) => el?.setAttribute('inert', ''));
    document.body.style.overflow = 'hidden';
    // 等面板滑入视口后再移焦，避免焦点落在屏幕外
    setTimeout(() => {
      const firstLink = mobileMenu?.querySelector('.mobile-nav-link');
      if (firstLink instanceof HTMLElement) firstLink.focus();
    }, 200);
  }

  function closeMenu() {
    if (!isOpen()) return;
    mobileMenu?.classList.remove('is-open');
    menuToggle?.classList.remove('is-active');
    menuToggle?.setAttribute('aria-expanded', 'false');
    // 必须先解除 inert 再归还焦点：汉堡按钮就在 .header-container 里，
    // 仍处于 inert 时 focus() 是无效的。
    inertTargets().forEach((el) => el?.removeAttribute('inert'));
    document.body.style.overflow = '';
    // 若因视口变宽而关闭，按钮已 display:none，则不抢焦点
    if (menuToggle instanceof HTMLElement && menuToggle.offsetParent !== null) {
      menuToggle.focus();
    }
  }

  menuToggle?.addEventListener('click', openMenu);
  menuClose?.addEventListener('click', closeMenu);
  menuOverlay?.addEventListener('click', closeMenu);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) closeMenu();
  });

  // 焦点陷阱：inert 只能冻结 header / main / footer，而 skip-link 挂在 body 上，
  // Tab 走到抽屉最后一项后仍会跳到它。声明了 aria-modal 就必须真正闭环，
  // 所以在抽屉内做 Tab 循环。
  const menuPanel = mobileMenu?.querySelector('.mobile-menu-panel');

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || !isOpen() || !menuPanel) return;

    const focusables = Array.from(
      menuPanel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')
    ).filter((el) => el.offsetParent !== null);
    if (focusables.length === 0) return;

    const first = focusables[0]!;
    const last = focusables[focusables.length - 1]!;
    const active = document.activeElement;

    if (e.shiftKey && (active === first || !menuPanel.contains(active))) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && (active === last || !menuPanel.contains(active))) {
      e.preventDefault();
      first.focus();
    }
  });

  // 点击抽屉内链接后关闭（同页锚点不会触发导航，故同时监听 hashchange）
  mobileMenu?.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
  window.addEventListener('hashchange', closeMenu);

  // 视口回到桌面宽度时抽屉必须自动关闭：否则遮罩与 inert 会残留在无汉堡按钮的布局里
  window.addEventListener('resize', () => {
    if (window.innerWidth > MOBILE_BREAKPOINT) closeMenu();
  });

  // 把顶栏真实高度写进 --app-nav-height，供 scroll-margin / 粘性定位消费
  if (siteHeader) {
    const syncNavHeight = () => {
      const height = Math.ceil(siteHeader.getBoundingClientRect().height);
      document.documentElement.style.setProperty('--app-nav-height', `${height}px`);
    };
    syncNavHeight();
    new ResizeObserver(syncNavHeight).observe(siteHeader);
  }
</script>

<style>
  /* 顶栏是外壳而非卡片：只有一条分隔线，不投影 */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 80;
    background-color: var(--nav-bg);
    backdrop-filter: blur(12px) saturate(180%);
    -webkit-backdrop-filter: blur(12px) saturate(180%);
    border-bottom: 1px solid var(--divider-color);
  }

  /* 外壳轨道 1280px，与页脚内条对齐；正文轨道（960px）更窄是刻意的 */
  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: var(--width-content);
    margin-inline: auto;
    padding: 0.6rem 1.5rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    color: var(--text-main);
    font-weight: 600;
    font-size: 1.1rem;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-standard);
  }

  .logo:hover {
    color: var(--accent-pink);
  }

  /* 固定尺寸，避免 SVG 加载前的布局抖动 */
  .logo-mark {
    display: block;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
  }

  .logo-text {
    letter-spacing: -0.01em;
  }

  .main-nav {
    display: block;
    min-width: 0;
  }

  .nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
  }

  /* 站内功能 ↔ 外站入口的分隔：横排导航里只有竖线能分隔 */
  .nav-sep {
    width: 1px;
    height: 18px;
    margin: 0 0.15rem;
    background-color: var(--divider-color);
    flex-shrink: 0;
  }

  /* 外站入口：与同组链接同色，「会离开本站」由 ↗ 图标表达，
     而不是把文字调灰——调灰会被读成禁用态 */
  .nav-link-external {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .ext-icon {
    flex-shrink: 0;
    color: var(--text-muted);
  }

  .nav-link-external:hover .ext-icon,
  .mobile-nav-link-external:hover .ext-icon {
    color: inherit;
  }

  .nav-link {
    display: block;
    padding: 0.4rem 0.75rem;
    color: var(--text-secondary);
    font-size: var(--fs-body);
    text-decoration: none;
    border-radius: var(--radius-control);
    transition:
      background-color var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }

  .nav-link:hover {
    background-color: var(--hover-bg);
    color: var(--text-main);
  }

  @supports (background-color: color-mix(in srgb, red, red)) {
    .nav-link:hover {
      background-color: var(--hover-bg-mix);
    }
  }

  .nav-link[aria-current='page'] {
    color: var(--accent-pink);
    font-weight: 500;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .mobile-menu-toggle {
    position: relative;
    z-index: 1; /* 顶栏内部的层级即可；抽屉整体已在顶栏之上 */
    display: none;
    align-items: center;
    justify-content: center;
    width: var(--control-h);
    height: var(--control-h);
    padding: 8px;
    background: none;
    border: none;
    border-radius: var(--radius-control);
    cursor: pointer;
    color: var(--text-main);
    transition: background-color var(--dur-fast) var(--ease-standard);
  }

  .mobile-menu-toggle:hover {
    background-color: var(--hover-bg);
  }

  .hamburger {
    display: block;
    position: relative;
    width: 20px;
    height: 2px;
    background-color: var(--text-main);
    border-radius: var(--radius-xs);
    transition: opacity 0.2s ease;
  }

  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--text-main);
    border-radius: var(--radius-xs);
    transition: transform 0.25s ease;
  }

  .hamburger::before {
    top: -6px;
  }

  .hamburger::after {
    top: 6px;
  }

  /* 汉堡 → X：中杠隐去，上下杠平移到中线后旋转。
   * 中杠必须用 background-color: transparent 而非 opacity: 0——
   * opacity 作用于整个元素，会把承载 X 两笔的 ::before/::after 一起变透明，
   * 按钮在打开态就成了一块空白。 */
  .mobile-menu-toggle.is-active .hamburger {
    background-color: transparent;
  }

  .mobile-menu-toggle.is-active .hamburger::before {
    transform: translateY(6px) rotate(45deg);
  }

  .mobile-menu-toggle.is-active .hamburger::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* 抽屉：用 visibility 而非 display 切换，进场/退场动画都能播完，
   * 且 visibility: hidden 会使内部链接退出焦点序列（display 切换做不到动画） */
  .mobile-menu {
    visibility: hidden;
    transition: visibility 0s linear 0.3s;
  }

  .mobile-menu.is-open {
    visibility: visible;
    transition-delay: 0s;
  }

  .mobile-menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 85; /* 抽屉已移出 header，必须压过顶栏的 80 */
    background-color: var(--overlay-bg);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .mobile-menu.is-open .mobile-menu-overlay {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-menu-panel {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    z-index: 90; /* 面板在遮罩之上 */
    width: 280px;
    max-width: 84vw;
    padding: 1.5rem;
    background-color: var(--surface-card);
    border-right: 1px solid var(--divider-color);
    box-shadow: var(--shadow-pop);
    overflow-y: auto;
    transform: translateX(-100%);
    transition: transform 0.3s ease-in-out;
  }

  .mobile-menu.is-open .mobile-menu-panel {
    transform: translateX(0);
  }

  /* 只剩一个关闭按钮，靠右 */
  .mobile-menu-header {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--divider-color);
  }

  .mobile-menu-close {
    position: relative;
    z-index: 75;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 0.25rem;
    background: none;
    border: none;
    border-radius: var(--radius-control);
    cursor: pointer;
    color: var(--text-secondary);
    transition:
      background-color var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }

  .mobile-menu-close:hover {
    background-color: var(--hover-bg);
    color: var(--text-main);
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.75rem 1rem;
    color: var(--text-body);
    font-size: var(--fs-subtitle);
    text-decoration: none;
    border-radius: var(--radius-control);
    transition:
      background-color var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }

  .mobile-nav-link:hover {
    background-color: var(--hover-bg);
    color: var(--accent-pink);
  }

  @supports (background-color: color-mix(in srgb, red, red)) {
    .mobile-nav-link:hover {
      background-color: var(--hover-bg-mix);
    }
  }

  /* 站内功能 ↔ 外站入口的分隔：纵向堆叠的抽屉里只有横线能起到分隔作用 */
  .mobile-nav-divider {
    height: 1px;
    background-color: var(--divider-color);
    margin: 0.75rem 0;
    list-style: none;
  }

  .mobile-nav-link-external {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  /* 唯一的导航断点；JS 中的 MOBILE_BREAKPOINT 必须同步 */
  @media (max-width: 1100px) {
    .header-container {
      padding: 0.4rem 0.85rem;
      flex-wrap: wrap;
    }

    .logo {
      font-size: 1.05rem;
    }

    /* 抽屉靠 JS 打开，所以「隐藏桌面导航 + 显示汉堡」这套只在有 JS 时成立。
     * 无 JS 时保持导航链接可见（必要时换行），否则窄屏下首页/标签/搜索三个
     * 入口会一起消失，整站在无 JS 下不可导航。 */
    :global(html.js) .main-nav {
      display: none;
    }

    :global(html.js) .mobile-menu-toggle {
      display: flex;
    }

    .main-nav {
      order: 3;
      width: 100%;
    }

    .nav-list {
      justify-content: center;
      padding-bottom: 0.25rem;
    }

    /* 主题开关与汉堡按钮贴在一起 */
    .header-actions {
      gap: 0.15rem;
    }
  }

  /* 触摸设备：控件视觉尺寸不变，用伪元素把命中区扩到 44px */
  @media (any-pointer: coarse) {
    .nav-link,
    .mobile-nav-link {
      display: flex;
      align-items: center;
      min-height: var(--tap-min);
    }

    .mobile-menu-toggle::after,
    .mobile-menu-close::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: var(--tap-min);
      height: var(--tap-min);
      transform: translate(-50%, -50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo,
    .nav-link,
    .main-site-link,
    .mobile-menu-toggle,
    .mobile-menu-close,
    .mobile-nav-link,
    .mobile-menu,
    .mobile-menu-overlay,
    .mobile-menu-panel,
    .hamburger,
    .hamburger::before,
    .hamburger::after {
      transition: none;
    }

    .main-site-link:hover {
      transform: none;
    }
  }
</style>
