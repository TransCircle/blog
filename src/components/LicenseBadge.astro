---
export interface Props {
  type: 'content' | 'code';
  license: string;
}

const { type, license } = Astro.props;

const licenseConfig: Record<string, { label: string; url: string; description: string; icon: string }> = {
  'CC-BY-SA-4.0': {
    label: 'CC BY-SA 4.0',
    url: 'https://creativecommons.org/licenses/by-sa/4.0/',
    description: '知识共享 署名-相同方式共享 4.0 国际',
    icon: 'cc',
  },
  'CC-BY-4.0': {
    label: 'CC BY 4.0',
    url: 'https://creativecommons.org/licenses/by/4.0/',
    description: '知识共享 署名 4.0 国际',
    icon: 'cc',
  },
  'CC0-1.0': {
    label: 'CC0 1.0',
    url: 'https://creativecommons.org/publicdomain/zero/1.0/',
    description: '公共领域 dedication',
    icon: 'cc',
  },
  'AGPL-3.0': {
    label: 'AGPL-3.0',
    url: 'https://www.gnu.org/licenses/agpl-3.0.html',
    description: 'GNU Affero General Public License v3.0',
    icon: 'code',
  },
  'MIT': {
    label: 'MIT',
    url: 'https://opensource.org/licenses/MIT',
    description: 'MIT License',
    icon: 'code',
  },
  'Apache-2.0': {
    label: 'Apache-2.0',
    url: 'https://www.apache.org/licenses/LICENSE-2.0',
    description: 'Apache License 2.0',
    icon: 'code',
  },
  'BSD-3-Clause': {
    label: 'BSD-3-Clause',
    url: 'https://opensource.org/licenses/BSD-3-Clause',
    description: 'BSD 3-Clause License',
    icon: 'code',
  },
  'Proprietary': {
    label: '专有',
    url: '#',
    description: '保留所有权利',
    icon: 'lock',
  },
};

const config = licenseConfig[license] ?? licenseConfig['Proprietary']!;
const label = type === 'content' ? '内容' : '代码';
---

<a
  href={config.url}
  target="_blank"
  rel="noopener noreferrer license"
  class="license-badge"
  title={`${label}协议: ${config.description}`}
  aria-label={`${label}采用 ${config.label} 协议`}
>
  <svg
    class="license-icon"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    {config.icon === 'cc' && (
      <>
        <circle cx="12" cy="12" r="10"/>
        <path d="M14.83 14.83c-.8 1.05-2.12 1.65-3.83 1.65-2.76 0-4.5-1.84-4.5-4.48 0-2.64 1.74-4.48 4.5-4.48 1.71 0 3.03.6 3.83 1.65"/>
        <path d="M9.17 9.17c.8-1.05 2.12-1.65 3.83-1.65 2.76 0 4.5 1.84 4.5 4.48 0 2.64-1.74 4.48-4.5 4.48-1.71 0-3.03-.6-3.83-1.65"/>
      </>
    )}
    {config.icon === 'code' && (
      <>
        <polyline points="16 18 22 12 16 6"/>
        <polyline points="8 6 2 12 8 18"/>
      </>
    )}
    {config.icon === 'lock' && (
      <>
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </>
    )}
  </svg>
  <span class="license-label">{config.label}</span>
</a>

<style>
  /* 徽章沿用全站 pill 视觉；焦点环由全局 :focus-visible 提供，此处不再本地声明 */
  .license-badge {
    position: relative; /* 触屏命中区伪元素的定位基准 */
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.15rem 0.6rem;
    background-color: var(--hover-bg);
    border: 1px solid var(--divider-color);
    border-radius: var(--radius-pill);
    color: var(--text-secondary);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.6;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-standard),
      border-color var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }

  .license-badge:hover {
    background-color: var(--soft-pink);
    border-color: var(--primary-pink);
    color: var(--accent-pink);
  }

  /* color-mix 可用时用更贴合主题的混色，不可用时回落到上面的 --soft-pink */
  @supports (background-color: color-mix(in srgb, red 15%, white)) {
    .license-badge:hover {
      background-color: var(--hover-bg-mix);
    }
  }

  .license-icon {
    flex-shrink: 0;
  }

  .license-label {
    white-space: nowrap;
  }

  /* 触屏：命中区靠伪元素撑开，徽章的视觉尺寸不动
     （直接给它 min-height: 44px 会把 26px 的胶囊拉成高椭圆） */
  @media (any-pointer: coarse) {
    .license-badge::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 0;
      right: 0;
      height: var(--tap-min);
      transform: translateY(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .license-badge {
      transition: none;
    }
  }
</style>
