---
// 分页导航（DESIGN v3.0 §5.8「分页为 --r-sm 按钮组」）。
// 上一页 / 下一页复用 Button（secondary），页码为 --r-sm 方形控件。
import Button from './ui/Button.astro';

export interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
}

const { currentPage, totalPages, baseUrl } = Astro.props;

// baseUrl 可能带结尾斜杠（如 "/"），拼接前必须去掉，否则会生成 "//page/2"
function getPageUrl(page: number): string {
  if (page === 1) return baseUrl;
  return `${baseUrl.replace(/\/$/, '')}/page/${page}`;
}

// 页码折叠：首页、末页、当前页 ±1 恒显示，中间省略（文章数增长后不铺满多行）。
type PageItem = number | 'gap';
function buildPageList(current: number, total: number): PageItem[] {
  const out: PageItem[] = [];
  for (let page = 1; page <= total; page++) {
    if (page === 1 || page === total || Math.abs(page - current) <= 1) {
      if (out[out.length - 1] !== page) out.push(page);
    } else if (out[out.length - 1] !== 'gap') {
      out.push('gap');
    }
  }
  return out;
}

const pageItems = buildPageList(currentPage, totalPages);
---

{totalPages > 1 && (
  <nav class="pagination" aria-label="分页导航">
    <div class="pagination-info">
      第 {currentPage} 页，共 {totalPages} 页
    </div>

    <div class="pagination-buttons">
      {currentPage > 1 && (
        <Button href={getPageUrl(currentPage - 1)} variant="secondary" size="md" aria-label="上一页">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
          上一页
        </Button>
      )}

      <div class="pagination-pages" role="group" aria-label="页码">
        {pageItems.map((page) =>
          page === 'gap' ? (
            <span class="pagination-gap" aria-hidden="true">
              …
            </span>
          ) : (
            <a
              href={getPageUrl(page)}
              class="pagination-page"
              aria-current={page === currentPage ? 'page' : undefined}
              aria-label={`第 ${page} 页`}
            >
              {page}
            </a>
          )
        )}
      </div>

      {currentPage < totalPages && (
        <Button href={getPageUrl(currentPage + 1)} variant="secondary" size="md" aria-label="下一页">
          下一页
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </Button>
      )}
    </div>
  </nav>
)}

<style>
  .pagination {
    margin-top: var(--s-6);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
    min-width: 0;
  }

  /* 页数是数字信息：--font-tech（§5.5 / §3.4） */
  .pagination-info {
    margin-bottom: var(--s-4);
    text-align: center;
    color: var(--text-muted);
    font-family: var(--font-tech);
    font-size: var(--fs-sm);
  }

  .pagination-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    flex-wrap: wrap;
    min-width: 0;
  }

  /* 页码是功能性控件，窄屏也不隐藏，只允许换行 */
  .pagination-pages {
    display: flex;
    justify-content: center;
    gap: var(--s-1);
    flex-wrap: wrap;
    min-width: 0;
  }

  .pagination-page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding: 0 var(--s-2);
    border: 1.5px solid transparent;
    border-radius: var(--r-sm);
    color: var(--text-secondary);
    font-family: var(--font-tech);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    text-decoration: none;
    transition:
      background-color var(--dur-1) var(--ease-standard),
      border-color var(--dur-1) var(--ease-standard),
      color var(--dur-1) var(--ease-standard),
      transform var(--dur-1) var(--ease-spring);
  }

  .pagination-page:hover {
    background-color: var(--pink-100);
    color: var(--pink-700);
  }

  .pagination-page:active {
    transform: scale(0.97);
  }

  /* 当前页是选中态而非主行动：淡粉填充 + 粉描边 + 墨字（三仓统一，§5.8）。 */
  .pagination-page[aria-current='page'],
  .pagination-page[aria-current='page']:hover {
    background-color: var(--pink-200);
    border-color: var(--pink-600);
    color: var(--ink);
  }

  .pagination-gap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--s-5);
    height: var(--btn-h);
    color: var(--text-muted);
    font-family: var(--font-tech);
    user-select: none;
  }

  @media (any-pointer: coarse) {
    .pagination-page {
      min-width: var(--tap-min);
      height: var(--tap-min);
    }
  }
</style>
