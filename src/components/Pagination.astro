---
// 分页导航。上一页/下一页复用 Button（secondary），页码为方形控件。
import Button from './ui/Button.astro';

export interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
}

const { currentPage, totalPages, baseUrl } = Astro.props;

// baseUrl 可能带结尾斜杠（如 "/"），拼接前必须去掉，否则会生成 "//page/2"
function getPageUrl(page: number): string {
  if (page === 1) return baseUrl;
  return `${baseUrl.replace(/\/$/, '')}/page/${page}`;
}
---

{totalPages > 1 && (
  <nav class="pagination" aria-label="分页导航">
    <div class="pagination-info">
      第 {currentPage} 页，共 {totalPages} 页
    </div>

    <div class="pagination-buttons">
      {currentPage > 1 && (
        <Button href={getPageUrl(currentPage - 1)} variant="secondary" size="md" aria-label="上一页">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
          上一页
        </Button>
      )}

      <div class="pagination-pages" role="group" aria-label="页码">
        {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
          <a
            href={getPageUrl(page)}
            class="pagination-page"
            aria-current={page === currentPage ? 'page' : undefined}
            aria-label={`第 ${page} 页`}
          >
            {page}
          </a>
        ))}
      </div>

      {currentPage < totalPages && (
        <Button href={getPageUrl(currentPage + 1)} variant="secondary" size="md" aria-label="下一页">
          下一页
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </Button>
      )}
    </div>
  </nav>
)}

<style>
  .pagination {
    margin-top: 2rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--divider-color);
    min-width: 0;
  }

  .pagination-info {
    margin-bottom: 1rem;
    text-align: center;
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .pagination-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    min-width: 0;
  }

  /* 页码是功能性控件，窄屏也不隐藏，只允许换行 */
  .pagination-pages {
    display: flex;
    justify-content: center;
    gap: 0.25rem;
    flex-wrap: wrap;
    min-width: 0;
  }

  .pagination-page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 0.4rem;
    border-radius: var(--radius-control);
    color: var(--text-secondary);
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color var(--dur-base) var(--ease-standard),
      color var(--dur-base) var(--ease-standard);
  }

  .pagination-page:hover {
    background-color: var(--hover-bg);
    color: var(--accent-pink);
  }

  @supports (background-color: color-mix(in srgb, red, red)) {
    .pagination-page:hover {
      background-color: var(--hover-bg-mix);
    }
  }

  .pagination-page[aria-current='page'],
  .pagination-page[aria-current='page']:hover {
    background-color: var(--cta-bg);
    color: var(--cta-color);
  }

  @media (any-pointer: coarse) {
    .pagination-page {
      min-height: var(--tap-min);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pagination-page {
      transition: none;
    }
  }
</style>
