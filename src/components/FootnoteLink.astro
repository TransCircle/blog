---
/**
 * 脚注链接组件
 * 用于在文本中渲染可点击的脚注引用
 * 
 * @example
 * <FootnoteLink id="fn-1" type="annotation" />
 * <FootnoteLink id="i" type="reference" />
 */

export interface Props {
  id: string;
  type?: 'annotation' | 'reference';
}

const { id, type = 'reference' } = Astro.props;

const typeClass = type === 'annotation' ? 'footnote-link-annotation' : 'footnote-link-reference';
const ariaLabel = type === 'annotation' ? `脚注注释 ${id}` : `引用资料 ${id}`;
---

<a 
  href={`#footnote-${id}`}
  id={`footnote-ref-${id}`}
  class={`footnote-link ${typeClass}`}
  role="doc-noteref"
  aria-label={ariaLabel}
>
  [<span class="footnote-index">{id}</span>]
</a>

<style>
  .footnote-link {
    display: inline;
    font-size: 0.75em;
    vertical-align: super;
    color: var(--accent-pink);
    text-decoration: none;
    cursor: pointer;
    margin: 0 0.1em;
    padding: 0 0.2em;
    border-radius: 3px;
    transition: all 0.2s ease;
  }

  .footnote-link:hover,
  .footnote-link:focus {
    background-color: var(--soft-pink);
    outline: 2px solid var(--accent-pink);
    outline-offset: 2px;
  }

  .footnote-index {
    font-weight: 600;
  }

  /* 注释类型的样式 */
  .footnote-link-annotation {
    color: var(--accent-pink);
  }

  /* 引用资料类型的样式 */
  .footnote-link-reference {
    color: #0066cc;
  }

  .footnote-link-reference:hover,
  .footnote-link-reference:focus {
    background-color: #e6f2ff;
    outline-color: #0066cc;
  }
</style>
