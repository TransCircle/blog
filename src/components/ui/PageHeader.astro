---
// 统一的页面标题尺度（DESIGN v3.0 §2.7）：eyebrow → 标题 → 描述。
// 全站页面都用它，不再各写各的 h1 区块。首页 hero 例外（见 HomeHero.astro，走 --fs-hero）。
export interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  align?: 'start' | 'center';
  class?: string;
}

const { title, description, eyebrow, align = 'start', class: className } = Astro.props;
---

<header class:list={['page-header', align === 'center' && 'is-center', className]}>
  <div class="texts">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="title">{title}</h1>
    {description && <p class="desc">{description}</p>}
    <slot />
  </div>
  {
    Astro.slots.has('actions') && (
      <div class="actions">
        <slot name="actions" />
      </div>
    )
  }
</header>

<style>
  .page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--s-4);
    flex-wrap: wrap;
  }

  /* flex:1 不可省：不给的话文字块会收缩成内容宽度，描述稍长就在半栏处提前折行，
     而不是用满整条阅读轨。 */
  .texts {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    min-width: 0;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  /* eyebrow：--fs-xs + --font-tech + 大写字距（§5.8 / §3.4） */
  .eyebrow {
    margin: 0;
    font-family: var(--font-tech);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  /* 页面标题是内容导航，不是海报：使用内容字体、600 字重和自然字距。 */
  .title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--fs-h1);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-heading);
    letter-spacing: 0;
    color: var(--ink);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .desc {
    margin: 0;
    font-size: var(--fs-lg);
    line-height: var(--lh-caption);
    color: var(--text-secondary);
    overflow-wrap: anywhere;
  }

  .is-center {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .is-center .texts {
    align-items: center;
  }

  @media (max-width: 640px) {
    .page-header {
      gap: var(--s-3);
    }
  }
</style>
