---
// 按钮（DESIGN v3.0 §5.1）。有 href 时渲染为 <a>，语义按用途选择。
// 高 40px（触屏 44px）、padding 0 20px、--r-sm、--fw-semibold --fs-sm。
// 禁止 pill 按钮：圆角一律 --r-sm（§2.8 同类同圆角铁律）。
export interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'danger';
  size?: 'sm' | 'md';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}

const {
  variant = 'secondary',
  size = 'md',
  href,
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const tagProps = href ? { href } : { type };
---

<Tag class:list={['btn', `is-${variant}`, `is-${size}`, className]} {...tagProps} {...rest}>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    border: 1.5px solid transparent;
    border-radius: var(--r-sm);
    font-family: inherit;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color var(--dur-1) var(--ease-standard),
      color var(--dur-1) var(--ease-standard),
      border-color var(--dur-1) var(--ease-standard),
      box-shadow var(--dur-1) var(--ease-standard),
      transform var(--dur-1) var(--ease-spring);
  }

  .is-md {
    height: var(--btn-h);
    padding: 0 var(--s-5);
  }

  .is-sm {
    height: 32px;
    padding: 0 var(--s-3);
  }

  /* 禁用态：视觉上明确「点不动」。 */
  .btn:disabled,
  .btn[aria-disabled='true'] {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .btn:disabled:active,
  .btn[aria-disabled='true']:active {
    transform: none;
  }

  /* loading（§5.1）：aria-busy + 内联 spinner 槽，由调用方传 .is-loading 与 --btn-spinner 内容。 */
  .btn.is-loading {
    pointer-events: none;
    opacity: 0.8;
  }

  .btn.is-loading::after {
    content: '';
    width: 14px;
    height: 14px;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: var(--r-pill);
    animation: btn-spin 600ms linear infinite;
  }

  @keyframes btn-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* 按压回弹：位移 ≤4px 的微交互，用 --ease-spring（§2.9） */
  .btn:active {
    transform: scale(0.97);
  }

  /* primary：唯一允许 hover 抬升 + 发光的一档（§3.2） */
  .is-primary {
    background-color: var(--pink-600);
    color: var(--on-pink);
  }

  .is-primary:hover {
    background-color: var(--pink-600-hover);
    color: var(--on-pink);
    transform: translateY(-1px);
  }

  .is-primary:active {
    transform: scale(0.97);
  }

  /* 暗色主题：主按钮 hover 带霓虹粉光（§3.2）。
   * :global 是必需的——主题选择器挂在 :root 上，拿不到本组件的 scope 标记。 */
  :global(:root[data-theme='dark']) .is-primary:hover {
    box-shadow: var(--glow-pink-dark);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .is-primary:hover {
      box-shadow: var(--glow-pink-dark);
    }
  }

  .is-secondary {
    background-color: transparent;
    border-color: var(--line-strong);
    color: var(--ink);
  }

  .is-secondary:hover {
    border-color: var(--pink-600);
    color: var(--pink-700);
  }

  .is-ghost {
    background-color: transparent;
    color: var(--text-secondary);
  }

  .is-ghost:hover {
    background-color: var(--pink-100);
    color: var(--ink);
  }

  .is-danger {
    background-color: transparent;
    border-color: var(--error-text);
    color: var(--error-text);
  }

  .is-danger:hover {
    background-color: var(--error-bg);
    color: var(--error-text);
  }

  /* 触屏：命中区抬到 44px（§4） */
  @media (any-pointer: coarse) {
    .btn {
      min-height: var(--tap-min);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn:active,
    .is-primary:hover {
      transform: none;
    }
  }
</style>
