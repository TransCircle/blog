---
// 只读徽章 / Chip（DESIGN v3.0 §5.6）：不可点、不进 Tab 序，用于分类等静态标记。
// 可点的标签链接不是 Pill —— 那是 .tag-chip（见 global.css）。
//
// 视觉配方定义在 global.css 的 .chip / .pill，因为搜索页的结果卡由 JS innerHTML
// 生成、拿不到 Astro 的 scoped 属性，必须与本组件共用同一份类。
export interface Props {
  /** accent = 粉档（--pink-100 / --pink-700），neutral = 凹陷面中性档 */
  tone?: 'neutral' | 'accent';
  class?: string;
}

const { tone = 'neutral', class: className } = Astro.props;
---

<span class:list={['pill', tone === 'accent' && 'pill-accent', className]}>
  <slot />
</span>
