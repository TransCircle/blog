---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';

const posts = await getCollection('posts');
const publishedPosts = posts
  .filter((post: CollectionEntry<'posts'>) => !post.data.draft)
  .sort((a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Build search index JSON for client-side search
const searchData = publishedPosts.map((post: CollectionEntry<'posts'>) => ({
  id: post.id,
  title: post.data.title,
  description: post.data.description || '',
  content: post.body || '',
  category: post.data.category,
  tags: post.data.tags,
  author: post.data.author,
  pubDate: post.data.pubDate.toISOString(),
  slug: post.slug,
}));

// Write search index to public directory (for client-side search)
const publicDir = path.join(process.cwd(), 'public');
if (!fs.existsSync(publicDir)) {
  fs.mkdirSync(publicDir, { recursive: true });
}
fs.writeFileSync(
  path.join(publicDir, 'search-index.json'),
  JSON.stringify(searchData, null, 2),
  'utf-8'
);

// Generate llms-full.txt for LLM indexing (write to both public and dist)
const llmsFullContent = `# TransCircle Development Blog - Content Snapshot
# https://blog.transcircle.org
# Generated: ${new Date().toISOString()}

## About This Blog

TransCircle Development Blog documents the development progress, team reports, and technical sharing for the TransCircle Project (https://transcircle.org), serving the Chinese MtF transgender community.

## Content License
- Text: CC BY-SA 4.0
- Code: AGPL-3.0

## Articles

${publishedPosts.map((post: CollectionEntry<'posts'>) => {
  const data = post.data;
  return `### ${data.title}
- URL: https://blog.transcircle.org/posts/${post.slug}/
- Date: ${data.pubDate.toISOString().split('T')[0]}
- Author: ${data.author}
- Category: ${data.category}
- Tags: ${data.tags.join(', ') || 'none'}
- License: ${data.contentLicense || 'CC-BY-SA-4.0'} (content), ${data.codeLicense || 'AGPL-3.0'} (code)
${data.description ? `- Description: ${data.description}` : ''}
`;
}).join('\n')}

## End of Snapshot
`;

fs.writeFileSync(
  path.join(publicDir, 'llms-full.txt'),
  llmsFullContent,
  'utf-8'
);

// Also write to dist if it exists (for production builds)
const distDir = path.join(process.cwd(), 'dist');
if (fs.existsSync(distDir)) {
  fs.writeFileSync(
    path.join(distDir, 'llms-full.txt'),
    llmsFullContent,
    'utf-8'
  );
}
---

<Layout title="搜索" description="搜索博客文章">
  <Header />

  <main id="main-content" class="container">
    <section class="search-page">
      <h1>搜索文章</h1>

      <div class="search-form">
        <label for="search-input" class="sr-only">搜索关键词</label>
        <div class="search-input-wrapper">
          <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input
            type="search"
            id="search-input"
            class="search-input"
            placeholder="输入关键词搜索..."
            autocomplete="off"
            aria-describedby="search-hint"
          />
        </div>
        <p id="search-hint" class="search-hint">支持搜索标题、描述、内容和标签</p>
      </div>

      <div id="search-results" class="search-results"></div>

      <div id="search-empty" class="search-empty hidden">
        <p>未找到匹配的文章</p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import Fuse, { type FuseResult } from 'fuse.js';

  interface SearchItem {
    id: string;
    title: string;
    description: string;
    content: string;
    category: string;
    tags: string[];
    author: string;
    pubDate: string;
    slug: string;
  }

  let fuse: Fuse<SearchItem> | null = null;

  async function initSearch(): Promise<void> {
    try {
      const response = await fetch('/search-index.json');
      if (!response.ok) {
        throw new Error(`Failed to load search index: ${response.status}`);
      }
      const searchData: SearchItem[] = await response.json();

      fuse = new Fuse(searchData, {
        keys: [
          { name: 'title', weight: 3 },
          { name: 'description', weight: 2 },
          { name: 'content', weight: 1 },
          { name: 'tags', weight: 2 },
        ],
        threshold: 0.4,
        includeScore: true,
      });

      console.log('[Search] Index loaded successfully,', searchData.length, 'articles');
    } catch (error) {
      console.error('[Search] Failed to initialize:', error);
    }
  }

  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const searchResults = document.getElementById('search-results');
  const searchEmpty = document.getElementById('search-empty');

  function formatDate(dateString: string): string {
    return new Date(dateString).toLocaleDateString('zh-CN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });
  }

  function renderResults(results: FuseResult<SearchItem>[]): void {
    if (!searchResults) return;

    if (results.length === 0) {
      searchResults.innerHTML = '';
      searchEmpty?.classList.remove('hidden');
      return;
    }

    searchEmpty?.classList.add('hidden');

    const html = results
      .map(
        (result) => `
          <article class="search-result">
            <div class="search-result-meta">
              <span class="search-result-category">${result.item.category}</span>
              <time class="search-result-date">${formatDate(result.item.pubDate)}</time>
            </div>
            <h2 class="search-result-title">
              <a href="/posts/${result.item.slug}/">${result.item.title}</a>
            </h2>
            ${result.item.description ? `<p class="search-result-description">${result.item.description}</p>` : ''}
            ${result.item.tags.length > 0 ? `
              <div class="search-result-tags">
                ${result.item.tags.map((tag: string) => `<a href="/tags/${tag}/" class="search-result-tag">#${tag}</a>`).join('')}
              </div>
            ` : ''}
          </article>
        `
      )
      .join('');

    searchResults.innerHTML = html;
  }

  function handleSearch(query: string): void {
    if (!fuse) {
      console.warn('[Search] Fuse not initialized yet');
      return;
    }

    if (!query.trim()) {
      searchResults!.innerHTML = '';
      searchEmpty?.classList.add('hidden');
      return;
    }

    const results = fuse.search(query);
    renderResults(results);
  }

  // Debounce search
  let debounceTimer: ReturnType<typeof setTimeout>;
  searchInput?.addEventListener('input', (e: Event) => {
    clearTimeout(debounceTimer);
    const target = e.target as HTMLInputElement;
    debounceTimer = setTimeout(() => {
      handleSearch(target.value);
    }, 200);
  });

  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSearch);
  } else {
    initSearch();
  }

  // Handle URL search param
  const urlParams = new URLSearchParams(window.location.search);
  const query = urlParams.get('q');
  if (query && searchInput) {
    searchInput.value = query;
    initSearch().then(() => handleSearch(query));
  }
</script>

<style>
  .search-page {
    padding: 2rem 0;
  }

  .search-page h1 {
    margin-bottom: 1.5rem;
  }

  .search-form {
    margin-bottom: 2rem;
  }

  .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    color: var(--text-muted);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 0.75rem 1rem 0.75rem 2.75rem;
    border: 1.5px solid var(--divider-color);
    border-radius: 8px;
    background-color: var(--bg-color);
    color: var(--text-body);
    font-size: 1rem;
    font-family: inherit;
    transition: border-color 0.2s cubic-bezier(0.4, 0, 0.2, 1),
                box-shadow 0.2s cubic-bezier(0.4, 0, 0.2, 1),
                transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .search-input:focus {
    outline: none;
    border-color: var(--primary-pink);
    box-shadow: 0 0 0 4px rgba(255, 133, 162, 0.15);
    transform: translateY(-1px);
  }

  .search-input::placeholder {
    color: var(--text-muted);
  }

  .search-hint {
    margin-top: 0.5rem;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .search-results {
    display: flex;
    flex-direction: column;
  }

  .search-result {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--divider-color);
  }

  .search-result:last-child {
    border-bottom: none;
  }

  .search-result-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    font-size: 0.82rem;
  }

  .search-result-category {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    background-color: var(--hover-bg);
    color: var(--accent-pink);
    border-radius: 4px;
    font-weight: 500;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .search-result-date {
    color: var(--text-muted);
  }

  .search-result-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .search-result-title a {
    color: var(--text-main);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .search-result-title a:hover {
    color: var(--accent-pink);
  }

  .search-result-description {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }

  .search-result-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .search-result-tag {
    color: var(--text-muted);
    font-size: 0.82rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .search-result-tag:hover {
    color: var(--accent-pink);
  }

  .search-empty {
    text-align: center;
    padding: 4rem 0;
    color: var(--text-muted);
  }

  .search-empty.hidden {
    display: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 768px) {
    .search-page {
      padding: 1rem 0;
    }

    .search-result-title {
      font-size: 1.1rem;
    }
  }
</style>
