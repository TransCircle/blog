---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import PageHeader from '@components/ui/PageHeader.astro';
import Button from '@components/ui/Button.astro';
---

<Layout
  title="页面未找到（404）"
  description="抱歉，您访问的页面不存在或已被移动。"
  noindex={true}
>
  <Header />

  <main id="main-content" tabindex="-1" class="container">
    {/* h1 由 PageHeader 渲染，section 的可及名称改用 aria-label 承载 */}
    <section class="not-found" aria-label="页面未找到">
      <p class="nf-code" aria-hidden="true">404</p>

      <PageHeader
        align="center"
        title="页面未找到"
        description="抱歉，您访问的页面不存在、已被移动或地址有误。"
      >
        <Fragment slot="actions">
          <Button variant="primary" href="/">返回首页</Button>
          <Button variant="secondary" href="/search">搜索文章</Button>
          <Button variant="secondary" href="/tags">浏览标签</Button>
        </Fragment>
      </PageHeader>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 4rem 0;
    min-width: 0;
  }

  /* 视觉性的大号 404：随视口收缩，不再需要断点覆盖 */
  .nf-code {
    font-size: clamp(3rem, 2rem + 5vw, 5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--accent-pink);
    margin: 0 0 0.5rem;
  }

  @media (max-width: 768px) {
    .not-found {
      padding: 3rem 0;
    }
  }
</style>
