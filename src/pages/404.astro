---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import PageHeader from '@components/ui/PageHeader.astro';
import Button from '@components/ui/Button.astro';
import { HOME_PATH, SEARCH_PATH, TAGS_PATH } from '@/lib/seo/url';
---

<Layout
  title="页面未找到（404）"
  description="抱歉，您访问的页面不存在或已被移动。"
  noindex={true}
>
  <Header />

  <main id="main-content" tabindex="-1" class="container">
    {/* h1 由 PageHeader 渲染，section 的可及名称改用 aria-label 承载 */}
    <section class="not-found" aria-label="页面未找到">
      <p class="nf-code" aria-hidden="true">404</p>

      <PageHeader
        align="center"
        title="页面未找到"
        description="抱歉，您访问的页面不存在、已被移动或地址有误。"
      >
        <Fragment slot="actions">
          <Button variant="primary" href={HOME_PATH}>返回首页</Button>
          <Button variant="secondary" href={SEARCH_PATH}>搜索文章</Button>
          <Button variant="secondary" href={TAGS_PATH}>浏览标签</Button>
        </Fragment>
      </PageHeader>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--s-8) 0;
    min-width: 0;
  }

  /* 错误码是 eyebrow，不把无信息的大数字做成页面主角。 */
  .nf-code {
    margin: 0 0 var(--s-2);
    font-family: var(--font-tech);
    font-size: var(--fs-display);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-display);
    letter-spacing: 0.04em;
    color: var(--pink-700);
  }

  @media (max-width: 768px) {
    .not-found {
      padding: var(--s-7) 0;
    }
  }
</style>
