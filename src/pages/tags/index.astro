---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import PageHeader from '@components/ui/PageHeader.astro';
import { getAllTags } from '@utils/posts';

const posts = await getCollection('posts');
const publishedPosts = posts.filter((post: CollectionEntry<'posts'>) => !post.data.draft);
const tags = getAllTags(publishedPosts);

// Count posts per tag
const tagCounts = new Map<string, number>();
tags.forEach((tag: string) => {
  const count = publishedPosts.filter((post: CollectionEntry<'posts'>) => post.data.tags.includes(tag)).length;
  tagCounts.set(tag, count);
});

const siteURL = Astro.site ? Astro.site.toString() : 'https://blog.transcircle.org/';
const tagsDescription = `跨环博客（TransCircle Blog）的全部文章标签，共 ${tags.length} 个标签、${publishedPosts.length} 篇文章，可按主题浏览。`;
const breadcrumbs = [
  { name: '首页', item: siteURL },
  { name: '标签', item: `${siteURL}tags/` },
];
---

<Layout title="全部标签" description={tagsDescription} breadcrumbs={breadcrumbs}>
  <Header />

  <main id="main-content" tabindex="-1" class="container">
    <section class="tags-page">
      <PageHeader
        title="标签"
        description={`共 ${tags.length} 个标签，${publishedPosts.length} 篇文章`}
      />

      {tags.length > 0 ? (
        <div class="tags-cloud">
          {tags.map((tag: string) => (
            <a href={`/tags/${tag}`} class="tag-item">
              <span class="tag-name">{tag}</span>
              <span class="tag-count">{tagCounts.get(tag)}</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>暂无标签</p>
        </div>
      )}
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .tags-page {
    padding: 2rem 0;
  }

  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* 可点标签（带计数）：Pill 视觉 + 真链接交互。
   * 不做 translateY 抬起——1px 抬起只留给 CTA 级元素，标签用颜色变化作为 hover 信号。 */
  .tag-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 100%;
    min-width: 0;
    padding: 0.5rem 1rem;
    background-color: var(--hover-bg);
    color: var(--text-secondary);
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-size: var(--fs-body);
    transition:
      background-color var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }

  .tag-item:hover {
    background-color: var(--soft-pink);
    color: var(--accent-pink);
  }

  @supports (background-color: color-mix(in srgb, red 15%, white)) {
    .tag-item:hover {
      background-color: var(--hover-bg-mix);
    }
  }

  .tag-name {
    min-width: 0;
    font-weight: 500;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .tag-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-width: 20px;
    height: 20px;
    padding: 0 0.35rem;
    background-color: var(--soft-pink);
    color: var(--text-main);
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 0;
    color: var(--text-muted);
  }

  /* 触屏：标签是主要导航入口，命中区必须够大 */
  @media (any-pointer: coarse) {
    .tag-item {
      min-height: var(--tap-min);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tag-item {
      transition: none;
    }
  }

  @media (max-width: 768px) {
    .tags-page {
      padding: 1rem 0;
    }
  }
</style>
