---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import PostCard from '@components/PostCard.astro';
import PageHeader from '@components/ui/PageHeader.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import { getPostsByTag, byNewest } from '@utils/posts';
import { tagDescription } from '@/data/tag-descriptions';
import { itemListNode, itemListId } from '@/lib/seo/schema';
import { HOME_PATH, TAGS_PATH, absoluteUrl, postPath, tagPath } from '@/lib/seo/url';
import { postModified } from '@/lib/seo/git-dates';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const publishedPosts = posts.filter((post: CollectionEntry<'posts'>) => !post.data.draft);
  const tagSet = new Set<string>();
  publishedPosts.forEach((post: CollectionEntry<'posts'>) => {
    post.data.tags.forEach((tag: string) => tagSet.add(tag));
  });

  return Array.from(tagSet).map((tag: string) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;

const posts = await getCollection('posts');
const publishedPosts = posts.filter((post: CollectionEntry<'posts'>) => !post.data.draft);
const taggedPosts = getPostsByTag<CollectionEntry<'posts'>>(publishedPosts, tag).sort(byNewest);

const tagURL = absoluteUrl(tagPath(tag));
const lede = tagDescription(
  tag,
  taggedPosts.map((post: CollectionEntry<'posts'>) => ({ title: post.data.title, category: post.data.category }))
);
const pageTitle = `${tag} 相关文章`;

const breadcrumbs = [
  { name: '首页', item: absoluteUrl('/') },
  { name: '标签', item: absoluteUrl(TAGS_PATH) },
  { name: tag, item: tagURL },
];

// 该标签下最新文章的修改时间：作为本页的 dateModified
const latestModified = taggedPosts
  .map((post: CollectionEntry<'posts'>) => postModified(post))
  .sort((a: Date, b: Date) => b.getTime() - a.getTime())[0];

const listSchema = itemListNode(
  tagURL,
  pageTitle,
  taggedPosts.map((post: CollectionEntry<'posts'>) => ({
    url: absoluteUrl(postPath(post.slug)),
    name: post.data.title,
  }))
);
---

<Layout
  title={pageTitle}
  description={lede}
  pageType="CollectionPage"
  tags={[tag]}
  breadcrumbs={breadcrumbs}
  updatedDate={latestModified}
  mainEntityId={itemListId(tagURL)}
  additionalSchemas={[listSchema]}
>
  <Header />

  <main id="main-content" tabindex="-1" class="container is-wide">
    <div class="page">
      <div class="tag-head">
        <Breadcrumbs items={[{ name: '首页', href: HOME_PATH }, { name: '标签', href: TAGS_PATH }, { name: tag }]} />

        <PageHeader eyebrow={`共 ${taggedPosts.length} 篇文章`} title={`#${tag}`} description={lede} />
      </div>

      <section aria-label="文章列表">
        <h2 class="sr-only">标签 {tag} 下的文章</h2>

        {taggedPosts.length > 0 ? (
          <div class="posts-grid">
            {taggedPosts.map((post: CollectionEntry<'posts'>) => (
              <PostCard post={post} />
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <h2 class="empty-state-title">该标签下暂无文章</h2>
            <p>换一个标签，或回到首页看最新的记录。</p>
          </div>
        )}
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* 面包屑与标题属于同一块，间距要比 .page 的 --s-6 更紧 */
  .tag-head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    min-width: 0;
  }

</style>
