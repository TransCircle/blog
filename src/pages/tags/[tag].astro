---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import PostCard from '@components/PostCard.astro';
import PageHeader from '@components/ui/PageHeader.astro';
import { getPostsByTag } from '@utils/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const publishedPosts = posts.filter((post: CollectionEntry<'posts'>) => !post.data.draft);
  const tagSet = new Set<string>();
  publishedPosts.forEach((post: CollectionEntry<'posts'>) => {
    post.data.tags.forEach((tag: string) => tagSet.add(tag));
  });

  return Array.from(tagSet).map((tag: string) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;

const posts = await getCollection('posts');
const publishedPosts = posts.filter((post: CollectionEntry<'posts'>) => !post.data.draft);
const taggedPosts = getPostsByTag(publishedPosts, tag).sort(
  (a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const siteURL = Astro.site ? Astro.site.toString() : 'https://blog.transcircle.org/';
const tagURL = new URL(`/tags/${tag}/`, Astro.site).toString();
const tagDescription = `跨环博客（TransCircle Blog）中标签为「${tag}」的全部文章，共 ${taggedPosts.length} 篇。`;

const breadcrumbs = [
  { name: '首页', item: siteURL },
  { name: '标签', item: `${siteURL}tags/` },
  { name: `#${tag}`, item: tagURL },
];

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${tagURL}#collection`,
  url: tagURL,
  name: `标签：${tag}`,
  description: tagDescription,
  isPartOf: { '@id': `${siteURL}#website` },
  inLanguage: 'zh-CN',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: taggedPosts.length,
    itemListElement: taggedPosts.map((post: CollectionEntry<'posts'>, i: number) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${siteURL}posts/${post.slug}/`,
      name: post.data.title,
    })),
  },
};
---

<Layout
  title={`标签：${tag}`}
  description={tagDescription}
  breadcrumbs={breadcrumbs}
  additionalSchemas={[collectionSchema]}
>
  <Header />

  <main id="main-content" tabindex="-1" class="container">
    <div class="page">
      <div class="tag-head">
        <nav class="tag-breadcrumb" aria-label="面包屑导航">
          <a href="/tags">标签</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">#{tag}</span>
        </nav>

        <PageHeader title={`#${tag}`} description={`共 ${taggedPosts.length} 篇文章`} />
      </div>

      {taggedPosts.length > 0 ? (
        <div class="posts-list">
          {taggedPosts.map((post: CollectionEntry<'posts'>) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p class="empty-state">该标签下暂无文章</p>
      )}
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* 面包屑与标题属于同一块，间距要比 .page 的 1.5rem 更紧 */
  .tag-head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  .tag-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    min-width: 0;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  /* 标签名长度不可控，必须允许换行断行 */
  .tag-breadcrumb [aria-current='page'] {
    min-width: 0;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .tag-breadcrumb a {
    color: var(--accent-pink);
    text-decoration: none;
  }

  .tag-breadcrumb a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .empty-state {
    padding: 3rem 0;
    text-align: center;
    color: var(--text-muted);
  }
</style>
