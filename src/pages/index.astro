---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import PostCard from '@components/PostCard.astro';
import Pagination from '@components/Pagination.astro';
import { POSTS_PER_PAGE, type Person } from '@utils/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const publishedPosts = posts.filter((post: CollectionEntry<'posts'>) => !post.data.draft);
  const totalPages = Math.ceil(publishedPosts.length / POSTS_PER_PAGE);

  const paths = [];
  for (let i = 1; i <= totalPages; i++) {
    paths.push({
      params: i === 1 ? undefined : { page: String(i) },
      props: { page: i },
    });
  }
  return paths;
}

const { page } = Astro.props;
const currentPage = page || 1;

const posts = await getCollection('posts');
const publishedPosts = posts
  .filter((post: CollectionEntry<'posts'>) => !post.data.draft)
  .sort((a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const totalPages = Math.ceil(publishedPosts.length / POSTS_PER_PAGE);
const startIndex = (currentPage - 1) * POSTS_PER_PAGE;
const paginatedPosts = publishedPosts.slice(startIndex, startIndex + POSTS_PER_PAGE);

const siteURL = Astro.site ? Astro.site.toString() : 'https://blog.transcircle.org/';
const homeTitle = '跨环博客';
const homeDescription =
  '跨环（TransCircle Project）官方博客：记录项目进展、社群知识与跨性别议题，涵盖跨性别医疗（HRT）、社群语言与档案、技术与设计实践，服务于中文 MtF 跨性别社群。内容遵循 CC BY-SA 4.0，代码遵循 AGPL-3.0。';

// Blog 结构化数据：列出最新文章，帮助搜索引擎与 AI 理解站点为「博客」实体及其文章集合
const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${siteURL}#blog`,
  url: siteURL,
  name: '跨环博客',
  alternateName: 'TransCircle Blog',
  description: homeDescription,
  inLanguage: 'zh-CN',
  publisher: { '@id': `${siteURL}#organization` },
  blogPost: publishedPosts.slice(0, 20).map((post: CollectionEntry<'posts'>) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    url: `${siteURL}posts/${post.slug}/`,
    datePublished: post.data.pubDate.toISOString(),
    ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
    ...(post.data.description ? { description: post.data.description } : {}),
    author: post.data.author.map((a: Person) => ({
      '@type': 'Person',
      name: a.name,
      ...(a.link ? { url: a.link } : {}),
    })),
  })),
};

const pageTitle = currentPage > 1 ? `${homeTitle}（第 ${currentPage} 页）` : homeTitle;
---

<Layout
  title={pageTitle}
  description={homeDescription}
  isHome={true}
  additionalSchemas={currentPage === 1 ? [blogSchema] : []}
>
  <Header />

  <main id="main-content" class="container">
    <section class="hero anim-fade-in-up" aria-label="博客介绍">
      <p class="hero-eyebrow">TransCircle Blog</p>
      <h1>跨环博客</h1>
      <p class="hero-description">
        记录项目进展、社群知识与跨性别议题
      </p>
      <p class="hero-beats">项目 · 知识 · 社群</p>
    </section>

    <section class="posts-section" aria-label="文章列表">
      <h2 class="section-title scroll-animate">最新文章</h2>

      {paginatedPosts.length > 0 ? (
        <div class="posts-list stagger-children">
          {paginatedPosts.map((post: CollectionEntry<'posts'>, index: number) => (
            <div class="scroll-animate" style={`transition-delay: ${index * 0.05}s`}>
              <PostCard post={post} />
            </div>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>暂无文章</p>
        </div>
      )}

      <div class="scroll-animate scroll-animate-delay-2">
        <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl="/" />
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .hero {
    padding: 3rem 0 2rem;
    text-align: center;
    border-bottom: 1px solid var(--divider-color);
    margin-bottom: 2rem;
  }

  /* 品牌小标：与 OG 卡片的「字标 → 站名 → 标语」锁定关系保持一致 */
  .hero-eyebrow {
    color: var(--accent-pink);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
  }

  .hero h1 {
    margin-bottom: 0.75rem;
  }

  .hero-description {
    color: var(--text-secondary);
    font-size: 1rem;
    max-width: 500px;
    margin: 0 auto;
  }

  .hero-beats {
    color: var(--text-muted);
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    margin: 0.85rem auto 0;
  }

  .section-title {
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 0;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .hero {
      padding: 2rem 0 1.5rem;
    }
  }
</style>
