---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import PostCard from '@components/PostCard.astro';
import Pagination from '@components/Pagination.astro';
import HomeHero from '@components/HomeHero.astro';
import SectionLabel from '@components/ui/SectionLabel.astro';
import { POSTS_PER_PAGE, type Person } from '@utils/posts';

// 首页是静态路由，只渲染第 1 页；第 2 页及之后由 src/pages/page/[page].astro 负责
const currentPage = 1;

const posts = await getCollection('posts');
const publishedPosts = posts
  .filter((post: CollectionEntry<'posts'>) => !post.data.draft)
  .sort((a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const totalPages = Math.ceil(publishedPosts.length / POSTS_PER_PAGE);
const paginatedPosts = publishedPosts.slice(0, POSTS_PER_PAGE);

const siteURL = Astro.site ? Astro.site.toString() : 'https://blog.transcircle.org/';
const homeTitle = 'Oakley Huang/羊圈Yan-Gyan';
const homeDescription =
  'Oakley Huang/羊圈Yan-Gyan 的个人博客，记录本地化、翻译与游戏相关的笔记与作品；作者为译者与填词人，代表译作：《电子依存症：摩登罗马书》、《形影伤红》、《八尺大人：芳草恶灵抄》。';

// Blog 结构化数据：列出最新文章，帮助搜索引擎与 AI 理解站点为「博客」实体及其文章集合
const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${siteURL}#blog`,
  url: siteURL,
  name: 'Oakley Huang/羊圈Yan-Gyan',
  alternateName: '个人博客',
  description: homeDescription,
  inLanguage: 'zh-CN',
  publisher: { '@id': `${siteURL}#organization` },
  blogPost: publishedPosts.slice(0, 20).map((post: CollectionEntry<'posts'>) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    url: `${siteURL}posts/${post.slug}/`,
    datePublished: post.data.pubDate.toISOString(),
    ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
    ...(post.data.description ? { description: post.data.description } : {}),
    author: post.data.author.map((a: Person) => ({
      '@type': 'Person',
      name: a.name,
      ...(a.link ? { url: a.link } : {}),
    })),
  }))
};
---

<Layout title={homeTitle} description={homeDescription} isHome={true} additionalSchemas={[blogSchema]}>
  <Header />

  <main id="main-content" tabindex="-1" class="container">
    <div class="page">
      <HomeHero />

      <section class="posts-section" aria-label="文章列表">
        <SectionLabel as="h2">最新文章</SectionLabel>
        <div class="posts-list">
          {paginatedPosts.map((post: CollectionEntry<'posts'>) => <PostCard post={post} />)}
        </div>
      </section>

      <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl="/" />
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .posts-list {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
</style>
