---
import { byNewest } from '@utils/posts';
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import PostCard from '@components/PostCard.astro';
import HomeHero from '@components/HomeHero.astro';
import SectionLabel from '@components/ui/SectionLabel.astro';
import Button from '@components/ui/Button.astro';
import { SITE_DESCRIPTION, SITE_NAME, SITE_NAME_EN } from '@/lib/seo/site';
import { BLOG_ID, blogNode, itemListNode } from '@/lib/seo/schema';
import { TAGS_PATH, absoluteUrl, postPath } from '@/lib/seo/url';
import { postModified } from '@/lib/seo/git-dates';

// 首页直接列出全部已发布文章，不分页：读者一屏就能看到站点写过什么，
// 每篇文章也都能从首页一跳到达（对爬虫发现新文章最有利）。
const posts = await getCollection('posts');
const publishedPosts = posts
  .filter((post: CollectionEntry<'posts'>) => !post.data.draft)
  .sort(byNewest);

// 首页标题直接包含站名与定位：这是品牌词搜索时唯一的落地页
const homeTitle = `${SITE_NAME} ${SITE_NAME_EN}｜中文 MtF 跨性别社群知识与项目记录`;

// 结构化数据：站点即「博客」实体（Blog），本页列出的文章用 ItemList 表达；
// 完整的 BlogPosting 在各文章页输出，这里不放缺字段的简要节点
const homeUrl = absoluteUrl('/');
const schemas = [
  blogNode(),
  itemListNode(
    homeUrl,
    '全部文章',
    publishedPosts.map((post: CollectionEntry<'posts'>) => ({
      url: absoluteUrl(postPath(post.slug)),
      name: post.data.title,
    }))
  ),
];
const latestModified = publishedPosts
  .map((post: CollectionEntry<'posts'>) => postModified(post))
  .sort((a: Date, b: Date) => b.getTime() - a.getTime())[0];
---

<Layout
  title={homeTitle}
  description={SITE_DESCRIPTION}
  isHome={true}
  pageType="CollectionPage"
  mainEntityId={BLOG_ID}
  updatedDate={latestModified}
  additionalSchemas={schemas}
>
  <Header />

  {/* 列表页走内容轨（is-wide）：卡片网格与顶栏 / 页脚内条同宽同左缘 */}
  <main id="main-content" tabindex="-1" class="container is-wide">
    <div class="page">
      <HomeHero />

      <section class="posts-section" aria-label="文章列表">
        <SectionLabel as="h2">全部文章 · {publishedPosts.length}</SectionLabel>

        {publishedPosts.length > 0 ? (
          <div class="posts-grid">
            {publishedPosts.map((post: CollectionEntry<'posts'>) => (
              <PostCard post={post} />
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M4 4h11l5 5v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z"/>
              <path d="M15 4v5h5"/>
              <line x1="8" y1="13" x2="14" y2="13"/>
              <line x1="8" y1="17" x2="12" y2="17"/>
            </svg>
            <h2 class="empty-state-title">暂无文章</h2>
            <p>新的记录正在写。先去标签页看看已有的主题吧。</p>
            <Button variant="primary" href={TAGS_PATH}>浏览标签</Button>
          </div>
        )}
      </section>
    </div>
  </main>

  <Footer />
</Layout>
