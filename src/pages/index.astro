---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import PostCard from '@components/PostCard.astro';
import Pagination from '@components/Pagination.astro';
import HomeHero from '@components/HomeHero.astro';
import SectionLabel from '@components/ui/SectionLabel.astro';
import Button from '@components/ui/Button.astro';
import { POSTS_PER_PAGE, type Person } from '@utils/posts';

// 首页是静态路由，只渲染第 1 页；第 2 页及之后由 src/pages/page/[page].astro 负责
const currentPage = 1;

const posts = await getCollection('posts');
const publishedPosts = posts
  .filter((post: CollectionEntry<'posts'>) => !post.data.draft)
  .sort((a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const totalPages = Math.ceil(publishedPosts.length / POSTS_PER_PAGE);
const paginatedPosts = publishedPosts.slice(0, POSTS_PER_PAGE);

const siteURL = Astro.site ? Astro.site.toString() : 'https://blog.transcircle.org/';
const homeTitle = '跨环博客';
const homeDescription =
  '跨环（TransCircle Project）官方博客：记录项目进展、社群知识与跨性别议题，涵盖跨性别医疗（HRT）、社群语言与档案、技术与设计实践，服务于中文 MtF 跨性别社群。内容遵循 CC BY-SA 4.0，代码遵循 AGPL-3.0。';

// Blog 结构化数据：列出最新文章，帮助搜索引擎与 AI 理解站点为「博客」实体及其文章集合
const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${siteURL}#blog`,
  url: siteURL,
  name: '跨环博客',
  alternateName: 'TransCircle Blog',
  description: homeDescription,
  inLanguage: 'zh-CN',
  publisher: { '@id': `${siteURL}#organization` },
  blogPost: publishedPosts.slice(0, 20).map((post: CollectionEntry<'posts'>) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    url: `${siteURL}posts/${post.slug}/`,
    datePublished: post.data.pubDate.toISOString(),
    ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
    ...(post.data.description ? { description: post.data.description } : {}),
    author: post.data.author.map((a: Person) => ({
      '@type': 'Person',
      name: a.name,
      ...(a.link ? { url: a.link } : {}),
    })),
  })),
};
---

<Layout title={homeTitle} description={homeDescription} isHome={true} additionalSchemas={[blogSchema]}>
  <Header />

  {/* 列表页走内容轨（is-wide）：卡片网格与顶栏 / 页脚内条同宽同左缘 */}
  <main id="main-content" tabindex="-1" class="container is-wide">
    <div class="page">
      <HomeHero />

      <section class="posts-section" aria-label="文章列表">
        <SectionLabel as="h2">最新文章</SectionLabel>

        {paginatedPosts.length > 0 ? (
          <div class="posts-grid">
            {paginatedPosts.map((post: CollectionEntry<'posts'>) => (
              <PostCard post={post} />
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M4 4h11l5 5v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z"/>
              <path d="M15 4v5h5"/>
              <line x1="8" y1="13" x2="14" y2="13"/>
              <line x1="8" y1="17" x2="12" y2="17"/>
            </svg>
            <h2 class="empty-state-title">暂无文章</h2>
            <p>新的记录正在写。先去标签页看看已有的主题吧。</p>
            <Button variant="primary" href="/tags">浏览标签</Button>
          </div>
        )}

        <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl="/" />
      </section>
    </div>
  </main>

  <Footer />
</Layout>
