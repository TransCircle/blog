---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import ReadingProgress from '@components/ReadingProgress.astro';
import LicenseBadge from '@components/LicenseBadge.astro';
import PersonLinks from '@components/PersonLinks.astro';
import FootnotePopover from '@components/FootnotePopover.astro';
import PageHeader from '@components/ui/PageHeader.astro';
import Pill from '@components/ui/Pill.astro';
import SectionLabel from '@components/ui/SectionLabel.astro';
import Button from '@components/ui/Button.astro';
import { formatDate, formatPeople, countWords } from '@utils/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  // 过滤草稿，保持与列表 / RSS / 搜索索引一致；未发布文章不生成页面，
  // 其 OG 端点（src/pages/og/[...slug].png.ts）也同样过滤，二者始终对应。
  return posts
    .filter((post: CollectionEntry<'posts'>) => !post.data.draft)
    .map((post: CollectionEntry<'posts'>) => ({
      params: { slug: post.slug },
      props: { post },
    }));
}

export interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await post.render();
const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  editor,
  category,
  tags,
  cover,
  contentLicense,
  codeLicense,
} = post.data;

const totalWordCount = countWords(post.body || '');

const formattedDate = formatDate(pubDate);
const formattedUpdatedDate = updatedDate ? formatDate(updatedDate) : null;

// author/editor 已被 schema 规整为 { name, link }[]；meta 标签只需纯文本
const authorText = formatPeople(author);

// 内容协议枚举 → 规范 URL（用于 BlogPosting 的 license 字段）；Proprietary 不输出
const LICENSE_URLS: Record<string, string> = {
  'CC-BY-SA-4.0': 'https://creativecommons.org/licenses/by-sa/4.0/',
  'CC-BY-4.0': 'https://creativecommons.org/licenses/by/4.0/',
  'CC0-1.0': 'https://creativecommons.org/publicdomain/zero/1.0/',
};
const licenseUrl = LICENSE_URLS[contentLicense];

const siteURL = Astro.site ? Astro.site.toString() : 'https://blog.transcircle.org/';
const breadcrumbs = [
  { name: '首页', item: siteURL },
  { name: title, item: new URL(`/posts/${post.slug}/`, Astro.site).toString() },
];

// 文章 OG 图：构建期按文章元数据自动生成的卡片（见 src/pages/og/[...slug].png.ts）。
// frontmatter 的 cover 仅用于页内题图，不再作为社交分享图。
const ogImage = `/og/${post.slug}.png`;

// 「下载 PDF」：成品 PDF 由构建脚本生成（dist/print/<slug>.pdf）。开发服务器（astro dev）
// 不生成 PDF，此时改为指向可实时渲染的打印视图页，便于本地预览排版。
const pdfHref = import.meta.env.DEV ? `/print/${post.slug}/` : `/print/${post.slug}.pdf`;
---

<Layout
  title={title}
  description={description || title}
  image={ogImage}
  type="article"
  author={authorText}
  authors={author}
  editors={editor}
  pubDate={pubDate}
  updatedDate={updatedDate}
  tags={tags}
  category={category}
  wordCount={totalWordCount}
  breadcrumbs={breadcrumbs}
  license={licenseUrl}
>
  <Header />

  {/* 阅读进度条（§5.10）：固定在顶栏下方，量程是 .article-content */}
  <ReadingProgress />

  <main id="main-content" tabindex="-1" class="container">
    <article class="post-article">
      <div class="post-header" data-reveal>
        <div class="meta-row">
          <Pill tone="accent">{category}</Pill>
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          {
            formattedUpdatedDate && (
              <>
                <span class="meta-sep" aria-hidden="true">
                  ·
                </span>
                <span>更新于 {formattedUpdatedDate}</span>
              </>
            )
          }
          <span class="meta-sep" aria-hidden="true">·</span>
          <span>约 {totalWordCount} 字</span>
        </div>

        <PageHeader title={title} description={description}>
          <div class="post-byline">
            <PersonLinks label="作者：" people={author} />
            <PersonLinks label="编辑：" people={editor} />
          </div>
        </PageHeader>
      </div>

      {
        cover && (
          <figure class="post-cover">
            <img src={cover} alt={`${title} 封面图`} loading="eager" />
          </figure>
        )
      }

      {/* 正文本身不做 reveal：阅读中的段落不该等动画，只有前后的区块入场 */}
      <div class="article-content">
        <Content />
      </div>

      <div class="post-export section-divider" data-reveal>
        <a class="pdf-link" href={pdfHref} download={!import.meta.env.DEV}>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          下载 PDF
        </a>
      </div>

      {
        tags.length > 0 && (
          <footer class="post-footer section-divider" data-reveal>
            <div class="post-tags">
              <span class="tags-label">标签：</span>
              <div class="tags-list">
                {tags.map((tag: string) => (
                  <a href={`/tags/${tag}`} class="tag-chip">
                    #{tag}
                  </a>
                ))}
              </div>
            </div>
          </footer>
        )
      }

      <footer class="post-license section-divider" aria-label="许可协议" data-reveal>
        <div class="license-content">
          <SectionLabel as="p">许可协议</SectionLabel>
          <div class="license-badges">
            <div class="license-group">
              <span class="license-type">内容</span>
              <LicenseBadge type="content" license={contentLicense} />
            </div>
            {/* 不写 codeLicense 就是没有代码要授权（见 src/content/config.ts） */}
            {codeLicense && (
              <div class="license-group">
                <span class="license-type">代码</span>
                <LicenseBadge type="code" license={codeLicense} />
              </div>
            )}
          </div>
        </div>
      </footer>
    </article>

    <nav class="post-nav section-divider" aria-label="文章导航">
      <Button variant="ghost" href="/">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        返回文章列表
      </Button>
    </nav>
  </main>

  <Footer />

  <!-- 脚注：引用标记的预览卡片 + 跳转后的返回链接（脚注区样式也在其中） -->
  <FootnotePopover />
</Layout>

<style>
  .post-article {
    min-width: 0;
  }

  /* 头部与正文之间只留空白：不画盒子边框，层级靠留白（§5.13） */
  .post-header {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    margin-bottom: var(--s-7);
    min-width: 0;
  }

  /* 分类是只读标记，用 Pill 呈现在元信息行里；它不是 PageHeader 的 eyebrow
   * （eyebrow 表示「所处分区」，语义不同），许可协议标题同理不是标题元素，故 SectionLabel as="p"。
   * 日期 / 字数是数字信息，走 --font-tech + --fs-xs（§5.5）。 */
  .meta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-2);
    min-width: 0;
    font-family: var(--font-tech);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .meta-sep {
    color: var(--text-muted);
  }

  .post-byline {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    margin-top: var(--s-2);
    min-width: 0;
  }

  .post-cover {
    margin: 0 0 var(--s-6);
    border-radius: var(--r-sm);
    overflow: hidden;
    box-shadow: var(--shadow-1);
  }

  .post-cover img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--r-sm);
  }

  /* 文末「下载 PDF」：控件档，--r-sm + 1.5px 描边（与 Button secondary 同规格） */
  .post-export {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
    min-width: 0;
  }

  .pdf-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    height: 40px;
    padding: 0 var(--s-4);
    border: 1.5px solid var(--line-strong);
    border-radius: var(--r-sm);
    background-color: transparent;
    color: var(--ink);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    text-decoration: none;
    transition:
      background-color var(--dur-1) var(--ease-standard),
      border-color var(--dur-1) var(--ease-standard),
      color var(--dur-1) var(--ease-standard);
  }

  .pdf-link:hover {
    border-color: var(--pink-600);
    color: var(--pink-700);
  }

  .pdf-link svg {
    flex: none;
  }

  @media (any-pointer: coarse) {
    .pdf-link {
      min-height: var(--tap-min);
    }
  }

  .post-tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-2);
    min-width: 0;
  }

  /* 触屏：标签的命中区是 44px（见 global.css），换行时行距要够，
     否则上下两行的命中区会重叠、点错标签 */
  @media (any-pointer: coarse) {
    .post-tags {
      gap: var(--s-4) var(--s-2);
    }
  }

  .tags-label {
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    min-width: 0;
  }

  .license-content {
    min-width: 0;
  }

  .license-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-5);
    min-width: 0;
  }

  .license-group {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-width: 0;
  }

  .license-type {
    font-size: var(--fs-sm);
    color: var(--text-secondary);
  }
</style>
