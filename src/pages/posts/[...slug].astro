---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import LicenseBadge from '@components/LicenseBadge.astro';
import PersonLinks from '@components/PersonLinks.astro';
import PageHeader from '@components/ui/PageHeader.astro';
import Pill from '@components/ui/Pill.astro';
import SectionLabel from '@components/ui/SectionLabel.astro';
import Button from '@components/ui/Button.astro';
import { formatDate, formatPeople } from '@utils/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  // 过滤草稿，保持与列表 / RSS / 搜索索引一致；未发布文章不生成页面，
  // 其 OG 端点（src/pages/og/[...slug].png.ts）也同样过滤，二者始终对应。
  return posts
    .filter((post: CollectionEntry<'posts'>) => !post.data.draft)
    .map((post: CollectionEntry<'posts'>) => ({
      params: { slug: post.slug },
      props: { post },
    }));
}

export interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await post.render();
const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  editor,
  category,
  tags,
  cover,
  contentLicense,
  codeLicense,
} = post.data;

// 计算字数（中文字符 + 英文单词）
const rawBody = post.body || '';
const chineseChars = (rawBody.match(/[\u4e00-\u9fa5]/g) || []).length;
const englishWords = (rawBody.match(/[a-zA-Z]+/g) || []).length;
const totalWordCount = chineseChars + englishWords;

const formattedDate = formatDate(pubDate);
const formattedUpdatedDate = updatedDate ? formatDate(updatedDate) : null;

// author/editor 已被 schema 规整为 { name, link }[]；meta 标签只需纯文本
const authorText = formatPeople(author);

// 内容协议枚举 → 规范 URL（用于 BlogPosting 的 license 字段）；Proprietary 不输出
const LICENSE_URLS: Record<string, string> = {
  'CC-BY-SA-4.0': 'https://creativecommons.org/licenses/by-sa/4.0/',
  'CC-BY-4.0': 'https://creativecommons.org/licenses/by/4.0/',
  'CC0-1.0': 'https://creativecommons.org/publicdomain/zero/1.0/',
};
const licenseUrl = LICENSE_URLS[contentLicense];

const siteURL = Astro.site ? Astro.site.toString() : 'https://blog.transcircle.org/';
const breadcrumbs = [
  { name: '首页', item: siteURL },
  { name: title, item: new URL(`/posts/${post.slug}/`, Astro.site).toString() },
];

// 文章 OG 图：构建期按文章元数据自动生成的卡片（见 src/pages/og/[...slug].png.ts）。
// frontmatter 的 cover 仅用于页内题图，不再作为社交分享图。
const ogImage = `/og/${post.slug}.png`;
---

<Layout
  title={title}
  description={description || title}
  image={ogImage}
  type="article"
  author={authorText}
  authors={author}
  editors={editor}
  pubDate={pubDate}
  updatedDate={updatedDate}
  tags={tags}
  category={category}
  wordCount={totalWordCount}
  breadcrumbs={breadcrumbs}
  license={licenseUrl}
>
  <Header />

  <main id="main-content" tabindex="-1" class="container">
    <article class="post-article">
      <div class="post-header">
        <div class="meta-row">
          <Pill tone="accent">{category}</Pill>
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          {
            formattedUpdatedDate && (
              <>
                <span class="meta-sep" aria-hidden="true">
                  ·
                </span>
                <span>更新于 {formattedUpdatedDate}</span>
              </>
            )
          }
        </div>

        <PageHeader title={title} description={description}>
          <div class="post-byline">
            <PersonLinks label="作者：" people={author} />
            <PersonLinks label="编辑：" people={editor} />
          </div>
        </PageHeader>
      </div>

      {
        cover && (
          <figure class="post-cover">
            <img src={cover} alt={`${title} 封面图`} loading="eager" />
          </figure>
        )
      }

      <div class="article-content">
        <Content />
      </div>

      {
        tags.length > 0 && (
          <footer class="post-footer section-divider">
            <div class="post-tags">
              <span class="tags-label">标签：</span>
              <div class="tags-list">
                {tags.map((tag: string) => (
                  <a href={`/tags/${tag}`} class="tag-link">
                    #{tag}
                  </a>
                ))}
              </div>
            </div>
          </footer>
        )
      }

      <footer class="post-license section-divider" aria-label="许可协议">
        <div class="license-content">
          <SectionLabel as="p">许可协议</SectionLabel>
          <div class="license-badges">
            <div class="license-group">
              <span class="license-type">内容</span>
              <LicenseBadge type="content" license={contentLicense} />
            </div>
            <div class="license-group">
              <span class="license-type">代码</span>
              <LicenseBadge type="code" license={codeLicense} />
            </div>
          </div>
        </div>
      </footer>
    </article>

    <nav class="post-nav section-divider" aria-label="文章导航">
      <Button variant="ghost" href="/">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        返回文章列表
      </Button>
    </nav>
  </main>

  <Footer />
</Layout>

<style>
  .post-article {
    padding: 2rem 0;
    min-width: 0;
  }

  /* 头部与正文之间只留空白：不画盒子边框，也避免与正文首个 h2 的上分隔线撞成双线 */
  .post-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
    min-width: 0;
  }

  /* 分类是只读标记，用 Pill 呈现在元信息行里；它不是 PageHeader 的 eyebrow
   * （eyebrow 表示「所处分区」，语义不同），许可协议标题同理不是标题元素，故 SectionLabel as="p"。 */
  .meta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    min-width: 0;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .meta-sep {
    color: var(--text-muted);
  }

  .post-byline {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 0.6rem;
    min-width: 0;
  }

  .post-cover {
    margin: 0 0 2rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .post-cover img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
  }

  .post-tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    min-width: 0;
  }

  .tags-label {
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    min-width: 0;
  }

  .license-content {
    min-width: 0;
  }

  .license-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    min-width: 0;
  }

  .license-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .license-type {
    font-size: var(--fs-sm);
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .post-article {
      padding: 1rem 0;
    }
  }
</style>
